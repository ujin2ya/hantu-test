<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>관리자 대시보드</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body {
      background: #f3f5fb;
      color: #1f2937;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
      padding: 28px 16px;
    }
    .wrap { max-width: 880px; margin: 0 auto; }
    .card-soft {
      background: #fff;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
      margin-bottom: 20px;
    }
    .card-soft h2 {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 14px;
      color: #0f172a;
    }
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
      margin-bottom: 8px;
    }
    .meta-cell {
      background: #f8fafc;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.82rem;
    }
    .meta-cell .label { color: #64748b; font-size: 0.72rem; margin-bottom: 4px; }
    .meta-cell .value { font-weight: 600; color: #0f172a; }
    .badge-soft {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 600;
    }
    .badge-soft.on  { background: #dcfce7; color: #166534; }
    .badge-soft.off { background: #fee2e2; color: #991b1b; }
    .badge-soft.run { background: #fef3c7; color: #92400e; }
    table.subs { font-size: 0.88rem; }
    table.subs th { font-weight: 600; color: #475569; font-size: 0.78rem; }
    table.subs td { vertical-align: middle; }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }
    .topbar h1 {
      font-size: 1.3rem;
      font-weight: 700;
      margin: 0;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <%- (typeof navHtml !== 'undefined' ? navHtml : '') %>
    <div class="topbar">
      <h1><i class="bi bi-speedometer2 me-2"></i>관리자 대시보드</h1>
      <a href="/admin/logout" class="text-decoration-none text-secondary small">
        <i class="bi bi-box-arrow-right me-1"></i>로그아웃
      </a>
    </div>

    <% if (flash) { %>
      <%
        const qs = (typeof query !== "undefined" && query) ? query : {};
        const flashMap = {
          missing_email: { type: "danger", msg: "이메일이 비어 있습니다." },
          not_found: { type: "danger", msg: "해당 이메일을 찾을 수 없습니다." },
          removed: { type: "success", msg: "구독자를 제거했습니다." },
          pattern_seeding: { type: "warning", msg: "패턴 시드가 이미 진행 중입니다." },
          pattern_seed_started: { type: "success", msg: "패턴 시드를 시작했습니다 (4~8분 소요). 새로고침으로 진행 확인." },
          pattern_analyzing: { type: "warning", msg: "패턴 분석이 이미 진행 중입니다." },
          pattern_analyze_started: { type: "success", msg: "패턴 분석을 시작했습니다 (~1분). pattern-result.json 재생성." },
          "1ds_mail_sent": { type: "success", msg: `1DS 단타 후보 메일을 발송했습니다 (${qs.n || ""}).` },
          "1ds_mail_one_sent": { type: "success", msg: `${qs.email ? decodeURIComponent(qs.email) : ""}에게 1DS 메일을 발송했습니다.` },
          no_1ds_result: { type: "danger", msg: "one-day-surge-board-result.json 파일이 없습니다. 먼저 보드를 생성하세요 (전체 보드 갱신 버튼)." },
          no_1ds_candidates: { type: "warning", msg: "1DS 보드에 후보가 0건입니다. 발송할 내용이 없습니다." },
          no_subscribers: { type: "warning", msg: "구독자가 없습니다." },
          no_smtp: { type: "danger", msg: "SMTP 설정이 안 되어 있습니다 (SMTP_USER / SMTP_PASS)." },
          mail_error: { type: "danger", msg: "메일 발송 중 오류가 발생했습니다." },
        };
        const f = flashMap[flash];
      %>
      <% if (f) { %>
        <div class="alert alert-<%= f.type %> small"><%= f.msg %></div>
      <% } %>
    <% } %>

    <!-- DB 신호 운영판 진입 -->
    <div class="card-soft" style="background:linear-gradient(135deg,#eef2ff 0%,#dbeafe 100%); border:1px solid #c7d2fe;">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <div>
          <h2 style="margin-bottom:4px;"><i class="bi bi-database me-1"></i>DB 신호 운영판</h2>
          <div style="color:#475569; font-size:.82rem; line-height:1.55;">
            매일 7개 보드 (QVA / QVA2 / VVI / 재돌파 / 1DS) 신호가 MySQL에 누적됩니다.
            <strong>오늘 집중 후보 · 여러 보드 동시 등장 · 최근 반복 · 보드별 성과 · link 전환율</strong>을 한 화면에서 확인할 수 있습니다.
            <span style="color:#92400e;">매수 추천 아님 — 먼저 살펴볼 순서</span>.
          </div>
        </div>
        <a href="/db-board" class="btn btn-primary" style="white-space:nowrap;">
          <i class="bi bi-arrow-right-circle me-1"></i>운영판 열기
        </a>
      </div>
    </div>

    <div class="card-soft">
      <h2><i class="bi bi-info-circle me-1"></i>운영 상태</h2>
      <div class="meta-grid">
        <div class="meta-cell">
          <div class="label">구독자</div>
          <div class="value"><%= subscribers.length %> / <%= maxSubscribers %></div>
        </div>
        <% if (typeof stocksMaster !== 'undefined' && stocksMaster) { %>
          <div class="meta-cell">
            <div class="label">종목 마스터</div>
            <div class="value">
              <% if (stocksMaster.stale) { %>
                <span class="badge-soft run"><%= stocksMaster.ageDays %>일 전 ⚠</span>
              <% } else { %>
                <%= stocksMaster.ageDays %>일 전
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
      <% if (typeof seededCount !== 'undefined') { %>
        <div class="meta-cell mt-2">
          <div class="label">차트 시드 종목</div>
          <div class="value"><%= seededCount %> 종목 — 일봉 캐시 (cache/stock-charts-long)</div>
        </div>
      <% } %>
      <div class="alert alert-info small mt-2 mb-0">
        현재 메인 모델: <strong>QVA_HIGHER_LOW</strong> (저점 상승 + 거래대금 증가) + <strong>QVA_EVOLUTION</strong> (구조 진화 필터) = <strong>QVA_STRONG</strong> (최우선)
        + <strong>VVI</strong> (거래대금 초동 + 신호 추적) 두 섹션만 패턴 페이지에 표시.
      </div>
    </div>

    <div class="card-soft">
      <h2><i class="bi bi-graph-up-arrow me-1"></i>보드 운영 (QVA / D+5 재돌파 / 1DS)</h2>
      <div class="small text-secondary mb-3">
        매일 평일 16:10 cron이 차트/수급 갱신 → 16:20 분석 → <strong>16:35 전체 보드 갱신 (QVA + D+5 재돌파 × 3 + 1DS + QVA2 × 3 = 8개 보드 순차)</strong>을 자동 실행합니다.
        cron이 부분 실패하거나 로컬에서 캐시를 sync한 후 보드를 다시 만들고 싶을 때 아래 버튼을 사용하세요.
      </div>
      <% if (typeof patternState !== 'undefined' && patternState) { %>
        <div class="row g-2 mb-3">
          <div class="col-12 col-md-6">
            <div class="meta-cell">
              <div class="label">일일 업데이트 상태</div>
              <div class="value">
                <% if (patternState.dailyUpdating) { %>
                  <span class="badge-soft run">진행중</span>
                  <span class="text-secondary small ms-2">약 20~30분 소요 (차트 + 수급 + 분석)</span>
                <% } else if (patternState.dailyUpdateFinishedAt) { %>
                  <span class="badge-soft on">완료</span>
                  <span class="text-secondary small ms-2"><%= new Date(patternState.dailyUpdateFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.dailyUpdateError) { %>
                  <div class="text-danger small mt-1"><%= patternState.dailyUpdateError %></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="meta-cell">
              <div class="label">보드 갱신 상태</div>
              <div class="value">
                <% if (patternState.refreshingBoard) { %>
                  <span class="badge-soft run">진행중</span>
                <% } else if (patternState.boardRefreshFinishedAt) { %>
                  <span class="badge-soft on">완료</span>
                  <span class="text-secondary small ms-2"><%= new Date(patternState.boardRefreshFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.boardRefreshError) { %>
                  <div class="text-danger small mt-1"><%= patternState.boardRefreshError %></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="meta-cell">
              <div class="label">패턴 분석 상태</div>
              <div class="value">
                <% if (patternState.analyzing) { %>
                  <span class="badge-soft run">진행중</span>
                <% } else if (patternState.analyzeFinishedAt) { %>
                  <span class="badge-soft on">완료</span>
                  <span class="text-secondary small ms-2"><%= new Date(patternState.analyzeFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.analyzeError) { %>
                  <div class="text-danger small mt-1"><%= patternState.analyzeError %></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12">
            <div class="meta-cell">
              <div class="label">1DS 분봉 수집 + 보드 재생성 상태</div>
              <div class="value">
                <% if (patternState.refreshing1dsIntraday) { %>
                  <span class="badge-soft run">진행중</span>
                  <% if (patternState.oneDsIntradayPhase) { %>
                    <span class="text-secondary small ms-2">단계: <%= patternState.oneDsIntradayPhase === 'collect' ? '분봉 수집 (KIS API)' : '보드 재생성' %></span>
                  <% } %>
                <% } else if (patternState.oneDsIntradayFinishedAt) { %>
                  <span class="badge-soft <%= patternState.oneDsIntradayError ? 'off' : 'on' %>">
                    <%= patternState.oneDsIntradayError ? '실패' : '완료' %>
                  </span>
                  <span class="text-secondary small ms-2">
                    <%= new Date(patternState.oneDsIntradayFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %>
                    · 수집 <%= patternState.oneDsIntradayCollected || 0 %>건 / 실패 <%= patternState.oneDsIntradayFailed || 0 %>건
                  </span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.oneDsIntradayError) { %>
                  <div class="text-danger small mt-1"><%= patternState.oneDsIntradayError %></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12">
            <div class="meta-cell">
              <div class="label">전체 보드 갱신 상태 (8개: QVA + 재돌파 × 3 + 1DS + QVA2 × 3)</div>
              <div class="value">
                <% if (patternState.refreshingAllBoards) { %>
                  <span class="badge-soft run">진행중</span>
                  <% if (patternState.allBoardsCurrent) { %>
                    <span class="text-secondary small ms-2">현재: <%= patternState.allBoardsCurrent %></span>
                  <% } %>
                <% } else if (patternState.allBoardsRefreshFinishedAt) { %>
                  <span class="badge-soft <%= patternState.allBoardsRefreshError ? 'off' : 'on' %>">
                    <%= patternState.allBoardsRefreshError ? '부분 실패' : '완료' %>
                  </span>
                  <span class="text-secondary small ms-2"><%= new Date(patternState.allBoardsRefreshFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.allBoardsRefreshError) { %>
                  <div class="text-danger small mt-1"><%= patternState.allBoardsRefreshError %></div>
                <% } %>
                <% if (patternState.allBoardsResults && patternState.allBoardsResults.length) { %>
                  <div class="small mt-1">
                    <% patternState.allBoardsResults.forEach(function(r) { %>
                      <span class="me-2"><%= r.ok ? '✅' : '❌' %> <%= r.name %><% if (r.elapsedMs) { %> <span class="text-secondary">(<%= r.elapsedMs %>ms)</span><% } %></span>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
      <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-info btn-sm"
          <%= (typeof patternState !== 'undefined' && patternState?.dailyUpdating) ? 'disabled' : '' %>
          onclick="runDailyUpdate()">
          <i class="bi bi-arrow-clockwise me-1"></i>⚡ 일일 업데이트 (차트+수급+분석+보드)
        </button>
        <button type="button" class="btn btn-success btn-sm"
          <%= (typeof patternState !== 'undefined' && patternState?.refreshingAllBoards) ? 'disabled' : '' %>
          onclick="refreshAllBoards()">
          <i class="bi bi-clipboard2-data me-1"></i>📋 전체 보드 갱신 (8개: QVA + 재돌파 × 3 + 1DS + QVA2 × 3)
        </button>
        <button type="button" class="btn btn-outline-success btn-sm"
          <%= (typeof patternState !== 'undefined' && patternState?.refreshingBoard) ? 'disabled' : '' %>
          onclick="refreshWatchlistBoard()">
          <i class="bi bi-clipboard-data me-1"></i>QVA 보드만 갱신
        </button>
        <button type="button" class="btn btn-warning btn-sm"
          <%= (typeof patternState !== 'undefined' && patternState?.refreshing1dsIntraday) ? 'disabled' : '' %>
          onclick="refresh1dsIntraday()">
          <i class="bi bi-graph-up-arrow me-1"></i>⚡ 1DS 분봉 수집 + 보드 갱신
        </button>
        <button type="button" class="btn btn-outline-warning btn-sm"
          <%= (typeof patternState !== 'undefined' && (patternState?.regen1dsScannerBoard || patternState?.refreshing1dsIntraday)) ? 'disabled' : '' %>
          onclick="regen1dsScannerBoard()">
          <i class="bi bi-arrow-repeat me-1"></i>🔁 1DS 스캐너+보드만 재생성 (KIS 호출 X)
        </button>
        <button type="button" id="refreshNasdaqThemeBtn" class="btn btn-outline-primary btn-sm"
          <%= (typeof patternState !== 'undefined' && patternState?.refreshingNasdaqTheme) ? 'disabled' : '' %>
          onclick="refreshNasdaqTheme()">
          <i class="bi bi-globe-americas me-1"></i>🔄 나스닥 테마 새로고침 (FMP/Yahoo ticker)
        </button>
        <form method="post" action="/admin/pattern/analyze" class="m-0" onsubmit="return confirm('패턴 분석을 다시 실행할까요? pattern-result.json 재생성 (~1분). 상세페이지의 진단 lookup에 사용됩니다.');">
          <button type="submit" class="btn btn-outline-secondary btn-sm" <%= (typeof patternState !== 'undefined' && patternState?.analyzing) ? 'disabled' : '' %>>
            <i class="bi bi-cpu me-1"></i>패턴 분석만 재실행
          </button>
        </form>
        <a href="/qva-watchlist" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-eye me-1"></i>QVA 보드
        </a>
        <a href="/rebreak" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-eye me-1"></i>D+5 재돌파
        </a>
        <a href="/one-day-surge-board" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-eye me-1"></i>1DS 단타
        </a>
        <a href="/qva2-watchlist" class="btn btn-outline-secondary btn-sm" style="border-color:#7c3aed;color:#a78bfa;">
          <i class="bi bi-eye me-1"></i>🟣 QVA2 H그룹/VPR
        </a>
        <a href="/qva2-d5-rebreak" class="btn btn-outline-secondary btn-sm" style="border-color:#7c3aed;color:#a78bfa;">
          <i class="bi bi-eye me-1"></i>🟣 QVA2 D+5
        </a>
        <a href="/qva2-vvi" class="btn btn-outline-secondary btn-sm" style="border-color:#7c3aed;color:#a78bfa;">
          <i class="bi bi-eye me-1"></i>🟣 QVA2 고점 재돌파
        </a>
      </div>
      <div class="small text-secondary mt-2">
        <strong>⚡ 일일 업데이트</strong>: KIS API로 차트/수급 새로 받아오고 분석+보드까지 한번에 (~20~30분). cron 실패 시 백업.<br>
        <strong>📋 전체 보드 갱신</strong>: 캐시는 그대로 두고 7개 보드 스크립트(QVA → QVA 고점 재돌파 → D+5 재돌파 운용 → 1DS → QVA2 H그룹/VPR → QVA2 D+5 → QVA2 고점 재돌파) 순차 실행 (~30~90초). 캐시 sync 후 모든 보드를 한 번에 갱신하고 싶을 때.<br>
        <strong>QVA 보드만 갱신</strong>: <code>qva-watchlist-board.js</code>만 재실행 (~10초).<br>
        <strong>🔁 1DS 스캐너+보드만 재생성</strong>: 분봉 수집 없이 <code>0930-scanner.js --mode full</code> + <code>one-day-surge-board.js</code>만 실행 (~10초). 이미 받아둔 분봉으로 결과만 새로 보고 싶을 때.<br>
        <strong>패턴 분석만 재실행</strong>: <code>pattern-result.json</code>만 재생성. 새 코드 배포 후 즉시 반영하고 싶을 때.
      </div>
    </div>

    <div class="card-soft">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0"><i class="bi bi-envelope me-1"></i>1DS 단타 메일 발송</h2>
      </div>
      <div class="small text-secondary mb-3">
        평일 09:30:30 cron이 자동 발송하지만, 즉시 발송하고 싶을 때 아래 버튼을 사용하세요.
        보드는 직전 평일 16:35에 갱신된 <code>reports/one-day-surge-board-result.json</code>을 사용합니다.
      </div>
      <form method="post" action="/admin/send-1ds-mail" class="m-0 d-inline" onsubmit="return confirm('전체 구독자(<%= subscribers.length %>명)에게 1DS 단타 메일을 지금 발송할까요?');">
        <button type="submit" class="btn btn-warning btn-sm" <%= subscribers.length === 0 ? 'disabled' : '' %>>
          <i class="bi bi-send me-1"></i>📧 전체 구독자에게 1DS 메일 발송 (<%= subscribers.length %>명)
        </button>
      </form>
    </div>

    <div class="card-soft">
      <h2><i class="bi bi-people me-1"></i>구독자 (<%= subscribers.length %>)</h2>
      <% if (subscribers.length === 0) { %>
        <div class="small text-muted">구독자가 없습니다.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm subs align-middle">
            <thead>
              <tr>
                <th>이메일</th>
                <th>구독일</th>
                <th class="text-end">관리</th>
              </tr>
            </thead>
            <tbody>
              <% subscribers.forEach(function(sub) { %>
                <tr>
                  <td><%= sub.email %></td>
                  <td>
                    <% if (sub.subscribedAt) { %>
                      <%= new Date(sub.subscribedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <form method="post" action="/admin/send-1ds-mail-one" class="d-inline me-1" onsubmit="return confirm('<%= sub.email %> 한 명에게만 1DS 단타 메일을 보낼까요?');">
                      <input type="hidden" name="email" value="<%= sub.email %>" />
                      <button type="submit" class="btn btn-outline-warning btn-sm" title="1DS 메일 보내기">
                        <i class="bi bi-envelope-arrow-up"></i>
                      </button>
                    </form>
                    <form method="post" action="/admin/unsubscribe" class="d-inline" onsubmit="return confirm('<%= sub.email %> 을(를) 구독 해제할까요?');">
                      <input type="hidden" name="email" value="<%= sub.email %>" />
                      <button type="submit" class="btn btn-outline-danger btn-sm" title="구독 해제">
                        <i class="bi bi-x-circle"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="text-center small text-secondary mt-3">
      <a href="/" class="text-decoration-none text-secondary me-3"><i class="bi bi-arrow-left me-1"></i>홈으로</a>
      <a href="/subscribe" class="text-decoration-none text-secondary"><i class="bi bi-envelope-plus me-1"></i>구독 페이지</a>
    </div>
  </div>

  <script>
    async function runDailyUpdate() {
      const msg = '일일 업데이트를 실행할까요? (차트 + 수급 + 분석, 약 20~30분 소요)';
      if (!confirm(msg)) return;

      try {
        const resp = await fetch('/admin/run-daily-update', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok) {
          if (resp.status === 401 || resp.redirected) {
            alert('인증이 만료됐습니다. 페이지를 새로고침해서 다시 로그인하세요.');
            return;
          }
          alert('요청 실패: ' + resp.status);
          return;
        }
        // 서버 상태 업데이트 대기 후 페이지 새로고침 (300ms)
        setTimeout(() => { location.reload(); }, 300);
      } catch (e) {
        alert('오류: ' + e.message);
      }
    }

    async function refreshWatchlistBoard() {
      const msg = '보드 화면(qva-watchlist-board.html)을 다시 만들까요? (~10초)\n\n' +
        '※ pattern-result.json은 건드리지 않습니다.\n' +
        '※ cache 데이터가 새로 sync된 뒤 보드 화면이 안 바뀔 때 사용하세요.';
      if (!confirm(msg)) return;
      try {
        const resp = await fetch('/admin/refresh-watchlist-board', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok || resp.redirected) {
          alert('인증이 만료됐거나 요청 실패. 페이지를 새로고침해서 다시 로그인하세요.\nstatus=' + resp.status);
          return;
        }
        const data = await resp.json();
        if (data.success) {
          alert('보드 갱신 시작됨. ~10초 후 /qva-watchlist 새로고침해서 확인하세요.');
        } else {
          alert('실패: ' + (data.message || '알 수 없는 오류'));
        }
      } catch (e) {
        alert('오류: ' + e.message);
      }
    }

    async function refresh1dsIntraday() {
      const msg = '1DS 분봉을 KIS에서 수집하고 보드를 재생성할까요?\n\n' +
        '· 보드 mainPool 후보(~15~25개)에 한해 09:00~10:00 분봉 수집\n' +
        '· 수집 후 1DS 보드 자동 재생성 → 트레이드 플랜 분봉 반영\n' +
        '· 약 30초 ~ 1분 소요';
      if (!confirm(msg)) return;
      try {
        const resp = await fetch('/admin/refresh-1ds-intraday', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok || resp.redirected) {
          alert('인증이 만료됐거나 요청 실패. status=' + resp.status);
          return;
        }
        const data = await resp.json();
        if (data.success) {
          alert('1DS 분봉 수집 + 보드 갱신 시작됨 (백그라운드). 약 30초~1분 후 /one-day-surge-board 새로고침.');
          setTimeout(() => { location.reload(); }, 5000);
        } else {
          alert('실패: ' + (data.message || '알 수 없는 오류'));
        }
      } catch (e) {
        alert('오류: ' + e.message);
      }
    }

    async function regen1dsScannerBoard() {
      const msg = '1DS 스캐너+보드만 재생성할까요? (KIS 호출 X)\n\n' +
        '· 이미 수집된 분봉으로 09:30 스캐너 full 모드 재실행\n' +
        '· 그 결과로 1DS 보드 HTML/JSON 재생성\n' +
        '· 분봉 추가 수집은 안 함 — 기존 data/intraday/1ds 그대로 사용\n' +
        '· 약 10초 소요';
      if (!confirm(msg)) return;
      try {
        const resp = await fetch('/admin/regen-1ds-scanner-board', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok || resp.redirected) {
          alert('인증이 만료됐거나 요청 실패. status=' + resp.status);
          return;
        }
        const data = await resp.json();
        if (data.success) {
          alert('1DS 스캐너+보드 재생성 시작됨 (백그라운드). 10초 후 /one-day-surge-board 새로고침.');
          setTimeout(() => { location.reload(); }, 5000);
        } else {
          alert('실패: ' + (data.message || '알 수 없는 오류'));
        }
      } catch (e) {
        alert('오류: ' + e.message);
      }
    }

    async function refreshNasdaqTheme() {
      const msg = '나스닥 테마 새로고침을 실행할까요?\n\n' +
        '· FMP/Yahoo에서 미국 ticker quote 재수집 (~30~60초)\n' +
        '· nasdaq-theme-watch-board 재생성\n' +
        '· theme-1ds-watch-pool 재생성\n' +
        '· 06:30 cron과 동일 시퀀스, source=manual로 기록됨\n' +
        '※ ticker 데이터 조회 시 시간이 걸릴 수 있습니다.';
      if (!confirm(msg)) return;
      const btn = document.getElementById('refreshNasdaqThemeBtn');
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>새로고침 중...'; }
      try {
        const resp = await fetch('/admin/refresh-nasdaq-theme', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok || resp.redirected) {
          alert('인증이 만료됐거나 요청 실패. status=' + resp.status);
          if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-globe-americas me-1"></i>🔄 나스닥 테마 새로고침 (FMP/Yahoo ticker)'; }
          return;
        }
        const data = await resp.json();
        if (data.ok) {
          alert('나스닥 테마 새로고침 시작됨 (백그라운드). 30~90초 후 /nasdaq-theme-watch 새로고침해서 확인하세요.');
          setTimeout(() => { location.reload(); }, 5000);
        } else if (data.running) {
          alert(data.message || '이미 실행 중입니다.');
          if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-globe-americas me-1"></i>🔄 나스닥 테마 새로고침 (FMP/Yahoo ticker)'; }
        } else {
          alert('실패: ' + (data.message || '알 수 없는 오류'));
          if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-globe-americas me-1"></i>🔄 나스닥 테마 새로고침 (FMP/Yahoo ticker)'; }
        }
      } catch (e) {
        alert('오류: ' + e.message);
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-globe-americas me-1"></i>🔄 나스닥 테마 새로고침 (FMP/Yahoo ticker)'; }
      }
    }

    async function refreshAllBoards() {
      const msg = '전체 보드를 다시 만들까요? (8개 보드 순차 — 약 40~120초)\n\n' +
        '실행 순서:\n' +
        '  1. QVA Watchlist Board (H그룹/VPR)\n' +
        '  2. D+5 재돌파 운용 보드\n' +
        '  3. D+5 재돌파 심층 검증 보고서\n' +
        '  4. D+5 재돌파 수급 백테스트\n' +
        '  5. 1-Day Surge Board (단타)\n' +
        '  6. QVA2 H그룹/VPR 보드 (실험)\n' +
        '  7. QVA2 D+5 재돌파 운용 (실험)\n' +
        '  8. QVA2 고점 재돌파 (실험)\n\n' +
        '※ pattern-result.json / cache는 건드리지 않습니다 (보드 스크립트만 재실행).';
      if (!confirm(msg)) return;
      try {
        const resp = await fetch('/admin/refresh-all-boards', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok || resp.redirected) {
          alert('인증이 만료됐거나 요청 실패. 페이지를 새로고침해서 다시 로그인하세요.\nstatus=' + resp.status);
          return;
        }
        const data = await resp.json();
        if (data.success) {
          alert('전체 보드 갱신 시작됨 (백그라운드). 40~120초 후 페이지 새로고침해서 진행 상태 확인.');
          // 5초 뒤 자동 새로고침해서 진행 상태 보여주기
          setTimeout(() => { location.reload(); }, 5000);
        } else {
          alert('실패: ' + (data.message || '알 수 없는 오류'));
        }
      } catch (e) {
        alert('오류: ' + e.message);
      }
    }
  </script>
</body>
</html>
