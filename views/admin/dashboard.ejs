<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>관리자 대시보드</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body {
      background: #f3f5fb;
      color: #1f2937;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
      padding: 28px 16px;
    }
    .wrap { max-width: 880px; margin: 0 auto; }
    .card-soft {
      background: #fff;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
      margin-bottom: 20px;
    }
    .card-soft h2 {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 14px;
      color: #0f172a;
    }
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
      margin-bottom: 8px;
    }
    .meta-cell {
      background: #f8fafc;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.82rem;
    }
    .meta-cell .label { color: #64748b; font-size: 0.72rem; margin-bottom: 4px; }
    .meta-cell .value { font-weight: 600; color: #0f172a; }
    .badge-soft {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 600;
    }
    .badge-soft.on  { background: #dcfce7; color: #166534; }
    .badge-soft.off { background: #fee2e2; color: #991b1b; }
    .badge-soft.run { background: #fef3c7; color: #92400e; }
    table.subs { font-size: 0.88rem; }
    table.subs th { font-weight: 600; color: #475569; font-size: 0.78rem; }
    table.subs td { vertical-align: middle; }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }
    .topbar h1 {
      font-size: 1.3rem;
      font-weight: 700;
      margin: 0;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <h1><i class="bi bi-speedometer2 me-2"></i>관리자 대시보드</h1>
      <a href="/admin/logout" class="text-decoration-none text-secondary small">
        <i class="bi bi-box-arrow-right me-1"></i>로그아웃
      </a>
    </div>

    <% if (flash) { %>
      <%
        const flashMap = {
          missing_email: { type: "danger", msg: "이메일이 비어 있습니다." },
          not_found: { type: "danger", msg: "해당 이메일을 찾을 수 없습니다." },
          removed: { type: "success", msg: "구독자를 제거했습니다." },
          pattern_seeding: { type: "warning", msg: "패턴 시드가 이미 진행 중입니다." },
          pattern_seed_started: { type: "success", msg: "패턴 시드를 시작했습니다 (4~8분 소요). 새로고침으로 진행 확인." },
          pattern_analyzing: { type: "warning", msg: "패턴 분석이 이미 진행 중입니다." },
          pattern_analyze_started: { type: "success", msg: "패턴 분석을 시작했습니다 (~1분). pattern-result.json 재생성." },
          mail_sent: { type: "success", msg: "VVI 신호 메일을 발송했습니다." },
          no_result: { type: "danger", msg: "pattern-result.json 파일이 없습니다. 먼저 분석을 실행하세요." },
          mail_error: { type: "danger", msg: "메일 발송 중 오류가 발생했습니다." },
        };
        const f = flashMap[flash];
      %>
      <% if (f) { %>
        <div class="alert alert-<%= f.type %> small"><%= f.msg %></div>
      <% } %>
    <% } %>

    <div class="card-soft">
      <h2><i class="bi bi-info-circle me-1"></i>운영 상태</h2>
      <div class="meta-grid">
        <div class="meta-cell">
          <div class="label">구독자</div>
          <div class="value"><%= subscribers.length %> / <%= maxSubscribers %></div>
        </div>
        <% if (typeof stocksMaster !== 'undefined' && stocksMaster) { %>
          <div class="meta-cell">
            <div class="label">종목 마스터</div>
            <div class="value">
              <% if (stocksMaster.stale) { %>
                <span class="badge-soft run"><%= stocksMaster.ageDays %>일 전 ⚠</span>
              <% } else { %>
                <%= stocksMaster.ageDays %>일 전
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
      <% if (typeof seededCount !== 'undefined') { %>
        <div class="meta-cell mt-2">
          <div class="label">차트 시드 종목</div>
          <div class="value"><%= seededCount %> 종목 — 일봉 캐시 (cache/stock-charts-long)</div>
        </div>
      <% } %>
      <div class="alert alert-info small mt-2 mb-0">
        현재 메인 모델: <strong>QVA_HIGHER_LOW</strong> (저점 상승 + 거래대금 증가) + <strong>QVA_EVOLUTION</strong> (구조 진화 필터) = <strong>QVA_STRONG</strong> (최우선)
        + <strong>VVI</strong> (거래대금 초동 + 신호 추적) 두 섹션만 패턴 페이지에 표시.
      </div>
    </div>

    <div class="card-soft">
      <h2><i class="bi bi-graph-up-arrow me-1"></i>QVA 보드 운영</h2>
      <div class="small text-secondary mb-3">
        매일 16:10 cron이 차트/수급 갱신 → 16:20 분석 → 16:35 보드 갱신을 자동 실행합니다.
        cron이 부분 실패하거나 로컬에서 캐시를 sync한 후 보드를 다시 만들고 싶을 때 아래 버튼을 사용하세요.
      </div>
      <% if (typeof patternState !== 'undefined' && patternState) { %>
        <div class="row g-2 mb-3">
          <div class="col-12 col-md-6">
            <div class="meta-cell">
              <div class="label">일일 업데이트 상태</div>
              <div class="value">
                <% if (patternState.dailyUpdating) { %>
                  <span class="badge-soft run">진행중</span>
                  <span class="text-secondary small ms-2">약 20~30분 소요 (차트 + 수급 + 분석)</span>
                <% } else if (patternState.dailyUpdateFinishedAt) { %>
                  <span class="badge-soft on">완료</span>
                  <span class="text-secondary small ms-2"><%= new Date(patternState.dailyUpdateFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.dailyUpdateError) { %>
                  <div class="text-danger small mt-1"><%= patternState.dailyUpdateError %></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="meta-cell">
              <div class="label">보드 갱신 상태</div>
              <div class="value">
                <% if (patternState.refreshingBoard) { %>
                  <span class="badge-soft run">진행중</span>
                <% } else if (patternState.boardRefreshFinishedAt) { %>
                  <span class="badge-soft on">완료</span>
                  <span class="text-secondary small ms-2"><%= new Date(patternState.boardRefreshFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.boardRefreshError) { %>
                  <div class="text-danger small mt-1"><%= patternState.boardRefreshError %></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="meta-cell">
              <div class="label">패턴 분석 상태</div>
              <div class="value">
                <% if (patternState.analyzing) { %>
                  <span class="badge-soft run">진행중</span>
                <% } else if (patternState.analyzeFinishedAt) { %>
                  <span class="badge-soft on">완료</span>
                  <span class="text-secondary small ms-2"><%= new Date(patternState.analyzeFinishedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></span>
                <% } else { %>
                  <span class="text-secondary small">미실행</span>
                <% } %>
                <% if (patternState.analyzeError) { %>
                  <div class="text-danger small mt-1"><%= patternState.analyzeError %></div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
      <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-info btn-sm"
          <%= (typeof patternState !== 'undefined' && patternState?.dailyUpdating) ? 'disabled' : '' %>
          onclick="runDailyUpdate()">
          <i class="bi bi-arrow-clockwise me-1"></i>⚡ 일일 업데이트 (차트+수급+분석+보드)
        </button>
        <button type="button" class="btn btn-outline-success btn-sm"
          <%= (typeof patternState !== 'undefined' && patternState?.refreshingBoard) ? 'disabled' : '' %>
          onclick="refreshWatchlistBoard()">
          <i class="bi bi-clipboard-data me-1"></i>📋 보드 갱신
        </button>
        <form method="post" action="/admin/pattern/analyze" class="m-0" onsubmit="return confirm('패턴 분석을 다시 실행할까요? pattern-result.json 재생성 (~1분). 상세페이지의 진단 lookup에 사용됩니다.');">
          <button type="submit" class="btn btn-outline-secondary btn-sm" <%= (typeof patternState !== 'undefined' && patternState?.analyzing) ? 'disabled' : '' %>>
            <i class="bi bi-cpu me-1"></i>패턴 분석만 재실행
          </button>
        </form>
        <a href="/qva-watchlist" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-eye me-1"></i>/qva-watchlist 보드 보기
        </a>
      </div>
      <div class="small text-secondary mt-2">
        <strong>⚡ 일일 업데이트</strong>: KIS API로 차트/수급 새로 받아오고 분석+보드까지 한번에 (~20~30분). cron 실패 시 백업.<br>
        <strong>📋 보드 갱신</strong>: 캐시는 그대로 두고 <code>qva-watchlist-board.js</code>만 재실행 (~10초). 캐시 sync 후 보드가 안 바뀔 때.<br>
        <strong>패턴 분석만 재실행</strong>: <code>pattern-result.json</code>만 재생성. 새 코드 배포 후 즉시 반영하고 싶을 때.
      </div>
    </div>

    <div class="card-soft">
      <h2><i class="bi bi-people me-1"></i>구독자 (<%= subscribers.length %>)</h2>
      <% if (subscribers.length === 0) { %>
        <div class="small text-muted">구독자가 없습니다.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm subs align-middle">
            <thead>
              <tr>
                <th>이메일</th>
                <th>구독일</th>
                <th class="text-end">관리</th>
              </tr>
            </thead>
            <tbody>
              <% subscribers.forEach(function(sub) { %>
                <tr>
                  <td><%= sub.email %></td>
                  <td>
                    <% if (sub.subscribedAt) { %>
                      <%= new Date(sub.subscribedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <form method="post" action="/admin/unsubscribe" class="d-inline" onsubmit="return confirm('<%= sub.email %> 을(를) 구독 해제할까요?');">
                      <input type="hidden" name="email" value="<%= sub.email %>" />
                      <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-x-circle"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="text-center small text-secondary mt-3">
      <a href="/" class="text-decoration-none text-secondary me-3"><i class="bi bi-arrow-left me-1"></i>홈으로</a>
      <a href="/subscribe" class="text-decoration-none text-secondary"><i class="bi bi-envelope-plus me-1"></i>구독 페이지</a>
    </div>
  </div>

  <script>
    async function runDailyUpdate() {
      const msg = '일일 업데이트를 실행할까요? (차트 + 수급 + 분석, 약 20~30분 소요)';
      if (!confirm(msg)) return;

      try {
        const resp = await fetch('/admin/run-daily-update', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok) {
          if (resp.status === 401 || resp.redirected) {
            alert('인증이 만료됐습니다. 페이지를 새로고침해서 다시 로그인하세요.');
            return;
          }
          alert('요청 실패: ' + resp.status);
          return;
        }
        // 서버 상태 업데이트 대기 후 페이지 새로고침 (300ms)
        setTimeout(() => { location.reload(); }, 300);
      } catch (e) {
        alert('오류: ' + e.message);
      }
    }

    async function refreshWatchlistBoard() {
      const msg = '보드 화면(qva-watchlist-board.html)을 다시 만들까요? (~10초)\n\n' +
        '※ pattern-result.json은 건드리지 않습니다.\n' +
        '※ cache 데이터가 새로 sync된 뒤 보드 화면이 안 바뀔 때 사용하세요.';
      if (!confirm(msg)) return;
      try {
        const resp = await fetch('/admin/refresh-watchlist-board', { method: 'POST', credentials: 'same-origin' });
        if (!resp.ok || resp.redirected) {
          alert('인증이 만료됐거나 요청 실패. 페이지를 새로고침해서 다시 로그인하세요.\nstatus=' + resp.status);
          return;
        }
        const data = await resp.json();
        if (data.success) {
          alert('보드 갱신 시작됨. ~10초 후 /qva-watchlist 새로고침해서 확인하세요.');
        } else {
          alert('실패: ' + (data.message || '알 수 없는 오류'));
        }
      } catch (e) {
        alert('오류: ' + e.message);
      }
    }
  </script>
</body>
</html>
