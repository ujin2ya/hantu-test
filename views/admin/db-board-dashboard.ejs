<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DB 신호 운영판 (관리자)</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body { background:#0f172a; color:#cbd5e1; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo","Malgun Gothic",sans-serif; padding:24px 16px; }
    .wrap { max-width:1380px; margin:0 auto; }
    .topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; flex-wrap:wrap; gap:10px; }
    .topbar h1 { font-size:1.3rem; font-weight:700; margin:0; color:#f1f5f9; }
    .topbar .sub { color:#94a3b8; font-size:.85rem; margin-top:4px; }
    .card-soft { background:#1e293b; border:1px solid #334155; border-radius:14px; padding:18px 20px; box-shadow:0 4px 14px rgba(0,0,0,0.25); margin-bottom:18px; }
    .card-soft h2 { font-size:1rem; font-weight:700; margin-bottom:6px; color:#f1f5f9; display:flex; align-items:center; gap:8px; }
    .card-soft .hint { color:#94a3b8; font-size:.78rem; margin-bottom:12px; line-height:1.5; }
    .card-soft .err { color:#fca5a5; font-size:.8rem; background:#450a0a; border:1px solid #7f1d1d; padding:8px 12px; border-radius:8px; }
    .card-soft .empty { color:#64748b; font-size:.85rem; padding:16px; text-align:center; background:#0f172a; border-radius:8px; }
    table.t { font-size:.82rem; width:100%; color:#cbd5e1; }
    table.t th { font-weight:600; color:#94a3b8; font-size:.72rem; text-transform:uppercase; letter-spacing:.3px; border-bottom:2px solid #334155; padding:8px 8px; background:#0f172a; position:sticky; top:0; }
    table.t td { vertical-align:middle; padding:6px 8px; border-bottom:1px solid #334155; }
    table.t tr:hover td { background:#0f172a; }
    table.t .rank { color:#94a3b8; font-weight:600; width:32px; text-align:right; }
    table.t .code { color:#94a3b8; font-family:Menlo,Consolas,monospace; font-size:.75rem; }
    table.t .name a { color:#93c5fd; font-weight:600; text-decoration:none; }
    table.t .name a:hover { color:#dbeafe; text-decoration:underline; }
    table.t .num { text-align:right; font-variant-numeric:tabular-nums; }
    table.t .pos { color:#86efac; font-weight:600; }
    table.t .neg { color:#fca5a5; font-weight:600; }
    .pill { display:inline-block; padding:1.5px 7px; border-radius:999px; font-size:.7rem; font-weight:600; margin:1px 2px 1px 0; white-space:nowrap; }
    .pill-board { background:#1e1b4b; color:#c4b5fd; border:1px solid #4338ca; }
    .pill-pos   { background:#052e16; color:#86efac; border:1px solid #166534; }
    .pill-neg   { background:#450a0a; color:#fca5a5; border:1px solid #7f1d1d; }
    .pill-mut   { background:#0f172a; color:#94a3b8; border:1px solid #334155; }
    .pill-warn  { background:#3a1a04; color:#fde68a; border:1px solid #78350f; }
    .toolbar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .toolbar > span { color:#94a3b8; }
    .toolbar select, .toolbar input { font-size:.85rem; padding:6px 10px; border:1px solid #475569; border-radius:8px; background:#0f172a; color:#e2e8f0; }
    .toolbar select:focus, .toolbar input:focus { border-color:#60a5fa; outline:none; }
    .toolbar input[type="date"] { width:160px; }
    .toolbar input[type="text"] { width:180px; }
    .toolbar button { font-size:.85rem; padding:6px 14px; border-radius:8px; border:0; background:#2563eb; color:#fff; font-weight:600; cursor:pointer; }
    .toolbar button:hover { background:#1d4ed8; }
    .toolbar button.ghost { background:transparent; color:#cbd5e1; border:1px solid #475569; }
    .toolbar button.ghost:hover { background:#1e293b; }
    .meta-row { display:flex; gap:14px; align-items:center; font-size:.8rem; color:#94a3b8; margin-top:4px; }
    .meta-row strong { color:#f1f5f9; }
    .note-box { background:#3a2a08; border-left:4px solid #f59e0b; color:#fde68a; padding:10px 14px; border-radius:8px; font-size:.82rem; margin-bottom:16px; line-height:1.6; }
    .note-box strong { color:#fef3c7; }
    .note-box code { background:rgba(255,255,255,0.08); padding:1px 5px; border-radius:4px; font-size:.78rem; color:#fde68a; }
    .priority-bar { display:inline-block; height:6px; background:#3b82f6; border-radius:3px; vertical-align:middle; margin-left:6px; }
    .scroll-wrap { overflow-x:auto; }
    .scroll-wrap::-webkit-scrollbar { height:8px; }
    .scroll-wrap::-webkit-scrollbar-thumb { background:#475569; border-radius:4px; }
  </style>
</head>
<body>
  <div class="wrap">

    <!-- 보드 네비게이션 (7 보드의 통일 nav와 같은 톤) -->
    <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:14px;">
      <div style="background:linear-gradient(90deg,#064e3b 0%,#065f46 100%);border:1px solid #10b981;border-radius:8px;padding:8px 14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px;"><span style="color:#a7f3d0;font-weight:700;letter-spacing:0.3px;">🟢 운영 보드</span><a href="/qva2-watchlist" style="color:#e0e7ff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.08);">📋 H그룹/VPR</a><a href="/qva2-d5-rebreak" style="color:#e0e7ff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.08);">🔥 D+5 재돌파</a><a href="/qva2-vvi" style="color:#e0e7ff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.08);">🎯 고점 재돌파</a></div>
      <div style="background:linear-gradient(90deg,#1e1b4b 0%,#312e81 100%);border:1px solid #6366f1;border-radius:8px;padding:8px 14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px;"><span style="color:#c4b5fd;font-weight:700;letter-spacing:0.3px;">🟣 실험 라인</span><a href="/one-day-surge-board" style="color:#e0e7ff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.08);">⚡ 1DS 단타 후보</a></div>
      <div style="background:linear-gradient(90deg,#1e293b 0%,#334155 100%);border:1px solid #64748b;border-radius:8px;padding:8px 14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px;opacity:0.92;"><span style="color:#cbd5e1;font-weight:700;letter-spacing:0.3px;">📜 과거 보드</span><a href="/qva-watchlist" style="color:#e0e7ff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.08);">📋 H그룹/VPR (구)</a><a href="/rebreak" style="color:#e0e7ff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.08);">🔥 D+5 재돌파 (구)</a><a href="/qva-vvi-redefined-board" style="color:#e0e7ff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.08);">🎯 고점 재돌파 (구)</a></div>
      <div style="background:linear-gradient(90deg,#042f2e 0%,#134e4a 100%);border:1px solid #14b8a6;border-radius:8px;padding:8px 14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px;"><span style="color:#5eead4;font-weight:700;letter-spacing:0.3px;">📊 통합 보기</span><a href="/db-board" style="color:#fff;text-decoration:none;padding:3px 10px;border-radius:4px;background:rgba(255,255,255,0.22);border:1px solid #fff;font-weight:700;">🗄 DB 신호 운영판</a></div>
    </div>

    <!-- 상단 -->
    <div class="topbar">
      <div>
        <h1><i class="bi bi-database me-1"></i>DB 신호 운영판</h1>
        <div class="sub">매수 추천이 아닙니다 — 여러 보드에 반복/중복 등장한 종목을 압축해서 보는 통합 뷰</div>
      </div>
    </div>

    <!-- 필터 toolbar -->
    <div class="card-soft">
      <form method="get" action="/admin/db-board-dashboard">
        <div class="toolbar">
          <span style="color:#94a3b8; font-size:.85rem;">기준일</span>
          <input type="date" name="date" value="<%= date %>" />
          <span style="color:#94a3b8; font-size:.85rem;">반복 기간</span>
          <select name="days">
            <% for (const d of [20, 60, 180]) { %>
              <option value="<%= d %>" <%= Number(days) === d ? 'selected' : '' %>><%= d %>일</option>
            <% } %>
          </select>
          <span style="color:#94a3b8; font-size:.85rem;">limit</span>
          <select name="limit">
            <% for (const l of [20, 50, 100]) { %>
              <option value="<%= l %>" <%= Number(limit) === l ? 'selected' : '' %>><%= l %></option>
            <% } %>
          </select>
          <button type="submit"><i class="bi bi-search me-1"></i>조회</button>
          <span style="flex:1"></span>
          <span style="color:#94a3b8; font-size:.85rem;">종목 검색</span>
          <input type="text" name="stockCode" placeholder="005930" value="<%= stockSearch || '' %>" maxlength="6" pattern="\d{4,6}" />
          <button type="submit" class="ghost">히스토리</button>
        </div>
      </form>
    </div>

    <!-- DB 누적 상태 요약 -->
    <% if (sections.dbSummary && !errors.dbSummary) {
         const sum = sections.dbSummary;
         const t = sum.totals || {};
    %>
    <div class="card-soft" style="padding:14px 18px;">
      <h2 style="margin-bottom:8px;"><i class="bi bi-bar-chart-line"></i>DB 누적 현황</h2>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap:10px; font-size:.82rem;">
        <div style="background:#0f172a; border:1px solid #334155; border-radius:8px; padding:10px 12px;">
          <div style="color:#94a3b8; font-size:.72rem; text-transform:uppercase; letter-spacing:.4px;">전체 신호</div>
          <div style="color:#f1f5f9; font-size:1.3rem; font-weight:700;"><%= Number(t.total_signals || 0).toLocaleString() %></div>
          <div style="color:#94a3b8; font-size:.7rem;"><%= t.boards || 0 %> 보드 · <%= t.stocks || 0 %> 종목</div>
        </div>
        <div style="background:#0f172a; border:1px solid #334155; border-radius:8px; padding:10px 12px;">
          <div style="color:#94a3b8; font-size:.72rem; text-transform:uppercase; letter-spacing:.4px;">신호일 범위</div>
          <div style="color:#f1f5f9; font-size:.95rem; font-weight:600;"><%= t.min_date || '—' %></div>
          <div style="color:#94a3b8; font-size:.7rem;">~ <%= t.max_date || '—' %></div>
        </div>
        <div style="background:#0f172a; border:1px solid #334155; border-radius:8px; padding:10px 12px;">
          <div style="color:#94a3b8; font-size:.72rem; text-transform:uppercase; letter-spacing:.4px;">outcomes / links / runs</div>
          <div style="color:#f1f5f9; font-size:.95rem; font-weight:600;">
            <%= Number(sum.counts.outcomes || 0).toLocaleString() %>
            <span style="color:#475569"> · </span>
            <%= Number(sum.counts.links || 0).toLocaleString() %>
            <span style="color:#475569"> · </span>
            <%= Number(sum.counts.runs || 0).toLocaleString() %>
          </div>
          <div style="color:#94a3b8; font-size:.7rem;">D+N 성과 / cross-board 시퀀스 / 보드 실행</div>
        </div>
        <div style="background:#0f172a; border:1px solid #334155; border-radius:8px; padding:10px 12px;">
          <div style="color:#94a3b8; font-size:.72rem; text-transform:uppercase; letter-spacing:.4px;">source_type 분포</div>
          <% for (const s of (sum.bySource || [])) { %>
            <div style="font-size:.78rem; margin-top:2px;"><span class="pill <%= s.source_type === 'DAILY_RUN' ? 'pill-pos' : 'pill-mut' %>" style="padding:1px 6px;"><%= s.source_type %></span> <span style="color:#cbd5e1;"><%= Number(s.n).toLocaleString() %></span></div>
          <% } %>
        </div>
      </div>
      <div style="margin-top:10px; font-size:.78rem; color:#94a3b8;">보드별 분포:
        <% for (const b of (sum.byBoard || [])) { %>
          <span class="pill pill-board" style="margin-left:4px;" title="<%= b.board_name %>"><%= formatBoardName(b.board_name) %>: <%= Number(b.n).toLocaleString() %> (<%= b.stocks %>종)</span>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="note-box">
      <strong>💡 priority_score / 단계점수</strong> — 둘 다 매수 점수가 아닙니다. <code>먼저 볼 순서</code>를 돕는 보조 점수.<br>
      • <strong>priority_score</strong> = <code>board×10 + positive×5 − failed×8 + repeat×3 + strong×10</code> (출현 빈도 중심)<br>
      • <strong>단계점수 (stage_score)</strong> = 각 보드/단계의 weight 합산. 예: <code>VVI2_FIRED +16</code>, <code>BREAKOUT_SUCCESS +18</code>, <code>FAILED −15</code>, <code>BREACH_NO_RECOVER −18</code>. 단계가 진척된 종목이 자연스럽게 상위로.<br>
      • 모든 pill에 hover하면 원본 코드(<code>QVA2_WATCHLIST/VVI2_FIRED</code> 등)가 보입니다.
    </div>

    <!-- (검색 결과) 종목별 히스토리 -->
    <% if (stockSearch) { %>
      <div class="card-soft">
        <h2><i class="bi bi-clock-history"></i>종목 히스토리 — <%= stockSearch %><% if (stockHistory && stockHistory.stock_name) { %> <span style="color:#94a3b8; font-weight:400; font-size:.9rem;">(<%= stockHistory.stock_name %>)</span><% } %></h2>
        <div class="hint">최근 180일 동안 어떤 보드/단계에 떴는지 + 각 신호의 D+N 성과 + cross-board link</div>
        <% if (errors && errors.stockHistory) { %>
          <div class="err">API 오류: <%= errors.stockHistory %></div>
        <% } else if (!stockHistory || !stockHistory.signals || stockHistory.signals.length === 0) { %>
          <div class="empty">데이터 없음 — DB에 이 종목 신호가 없습니다.</div>
        <% } else { %>
          <div class="scroll-wrap">
            <table class="t">
              <thead>
                <tr>
                  <th>날짜</th><th>보드 / stage</th>
                  <th class="num">signal_price</th><th class="num">score</th>
                  <th>grade / label</th>
                  <th>outcomes</th><th>links</th>
                </tr>
              </thead>
              <tbody>
                <% for (const s of stockHistory.signals) { %>
                  <tr>
                    <td><%= s.signal_date %></td>
                    <td>
                      <span class="pill pill-board" title="<%= s.board_name %>"><%= formatBoardName(s.board_name) %></span>
                      <% if (negativeKinds.includes(s.signal_kind)) { %>
                        <span class="pill pill-neg" title="<%= s.signal_kind %>"><%= formatSignalKind(s.signal_kind) %></span>
                      <% } else if (positiveKinds.includes(s.signal_kind)) { %>
                        <span class="pill pill-pos" title="<%= s.signal_kind %>"><%= formatSignalKind(s.signal_kind) %></span>
                      <% } else { %>
                        <span class="pill pill-mut" title="<%= s.signal_kind %>"><%= formatSignalKind(s.signal_kind) %></span>
                      <% } %>
                    </td>
                    <td class="num"><%= s.signal_price != null ? Number(s.signal_price).toLocaleString() : '—' %></td>
                    <td class="num"><%= s.score != null ? Number(s.score).toFixed(0) : '—' %></td>
                    <td>
                      <% if (s.grade) { %><span class="pill pill-mut"><%= s.grade %></span><% } %>
                      <% if (s.status_label) { %><span style="color:#94a3b8; font-size:.78rem;"><%= s.status_label %></span><% } %>
                    </td>
                    <td>
                      <% if (!s.outcomes || s.outcomes.length === 0) { %>—<% } else { %>
                        <% for (const o of s.outcomes) { %>
                          <span class="pill pill-mut">D+<%= o.horizon_days %>: <%= o.close_return_pct != null ? (Number(o.close_return_pct) >= 0 ? '+' : '') + Number(o.close_return_pct).toFixed(1) + '%' : '—' %></span>
                        <% } %>
                      <% } %>
                    </td>
                    <td>
                      <% for (const l of (s.outgoing_links || [])) { %><span class="pill pill-board" title="<%= l.link_type %> → signal #<%= l.other_id %>">→ <%= l.link_type %></span><% } %>
                      <% for (const l of (s.incoming_links  || [])) { %><span class="pill pill-board" title="<%= l.link_type %> ← signal #<%= l.other_id %>">← <%= l.link_type %></span><% } %>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- 1. 오늘 집중 후보 -->
    <div class="card-soft">
      <h2><i class="bi bi-bullseye"></i>오늘 집중 후보 (priority_score 순)</h2>
      <div class="hint">기준일 <strong><%= date %></strong> 에 1+ 보드에 등장한 종목을 priority_score로 정렬. 매수 추천 아님 — 먼저 살펴볼 순서일 뿐.</div>
      <% if (errors.todayFocus) { %><div class="err">오류: <%= errors.todayFocus %></div>
      <% } else if (!sections.todayFocus || sections.todayFocus.length === 0) { %><div class="empty">데이터 없음 — <%= date %>에 DB 신호 없음.</div>
      <% } else { %>
        <div class="scroll-wrap"><table class="t">
          <thead>
            <tr>
              <th class="rank">#</th>
              <th>종목</th>
              <th class="num" title="board_count×10 + positive×5 - failed×8 + repeat×3 + strong×10">priority</th>
              <th class="num" title="단계별 KIND_WEIGHTS + BOARD_WEIGHTS 합산 (보조)">단계점수</th>
              <th class="num">boards</th>
              <th class="num">repeat<br/>(최근20일)</th>
              <th class="num">positive</th>
              <th class="num">failed</th>
              <th>보드 / 단계</th>
            </tr>
          </thead>
          <tbody>
            <% sections.todayFocus.forEach(function(r, i) { %>
              <tr>
                <td class="rank"><%= i + 1 %></td>
                <td><span class="code"><%= r.stock_code %></span> <span class="name"><a href="/db-board?date=<%= date %>&stockCode=<%= r.stock_code %>"><%= r.stock_name %></a></span></td>
                <td class="num"><strong><%= r.priority_score %></strong></td>
                <td class="num <%= Number(r.stage_score || 0) > 0 ? 'pos' : Number(r.stage_score || 0) < 0 ? 'neg' : '' %>"><%= r.stage_score != null ? r.stage_score : '—' %></td>
                <td class="num"><%= r.board_count %></td>
                <td class="num"><%= r.recent_repeat_count %></td>
                <td class="num pos"><%= r.positive_kind_count %></td>
                <td class="num <%= Number(r.failed_kind_count) > 0 ? 'neg' : '' %>"><%= r.failed_kind_count %></td>
                <td><% for (const bk of String(r.boards || '').split(', ')) { if (!bk) continue; const isNeg = negativeKinds.some(k => bk.endsWith('/'+k)); const isPos = positiveKinds.some(k => bk.endsWith('/'+k)); %><span class="pill <%= isNeg ? 'pill-neg' : isPos ? 'pill-pos' : 'pill-board' %>" title="<%= bk %>"><%= formatBoardKind(bk) %></span><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>

    <!-- 2. 여러 보드 동시 등장 -->
    <div class="card-soft">
      <h2><i class="bi bi-diagram-3"></i>여러 보드 동시 등장 (<%= date %>, FAILED 제외)</h2>
      <div class="hint">같은 날짜에 2+ 보드에서 동시에 잡힌 종목. 여러 모델이 동시에 보는 종목 우선 확인용.</div>
      <% if (errors.overlap) { %><div class="err">오류: <%= errors.overlap %></div>
      <% } else if (!sections.overlap || sections.overlap.length === 0) { %><div class="empty">데이터 없음 — <%= date %>에 2+ 보드 동시 등장 없음.</div>
      <% } else { %>
        <div class="scroll-wrap"><table class="t">
          <thead>
            <tr><th>종목</th><th class="num">board_count</th><th class="num">total_score</th><th>보드 / stage</th></tr>
          </thead>
          <tbody>
            <% sections.overlap.forEach(function(r) { %>
              <tr>
                <td><span class="code"><%= r.stock_code %></span> <span class="name"><a href="/admin/db-board-dashboard?date=<%= date %>&stockCode=<%= r.stock_code %>"><%= r.stock_name %></a></span></td>
                <td class="num"><strong><%= r.board_count %></strong></td>
                <td class="num"><%= r.total_score != null ? Number(r.total_score).toFixed(0) : '—' %></td>
                <td><% for (const bk of String(r.boards || '').split(', ')) { if (!bk) continue; const isPos = positiveKinds.some(k => bk.endsWith('/'+k)); %><span class="pill <%= isPos ? 'pill-pos' : 'pill-board' %>" title="<%= bk %>"><%= formatBoardKind(bk) %></span><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>

    <!-- 3. 최근 반복 등장 -->
    <div class="card-soft">
      <h2><i class="bi bi-arrow-repeat"></i>최근 반복 등장 (최근 <%= days %>일, 2회 이상)</h2>
      <div class="hint">한 종목이 여러 날·여러 보드에 반복해서 잡힘. failed_count가 큰 종목은 주의.</div>
      <% if (errors.repeated) { %><div class="err">오류: <%= errors.repeated %></div>
      <% } else if (!sections.repeated || sections.repeated.length === 0) { %><div class="empty">데이터 없음.</div>
      <% } else { %>
        <div class="scroll-wrap"><table class="t">
          <thead>
            <tr><th>종목</th><th class="num">signals</th><th class="num">boards</th><th class="num">positive</th><th class="num">failed</th><th>기간</th><th>보드 / stage</th></tr>
          </thead>
          <tbody>
            <% sections.repeated.forEach(function(r) { %>
              <tr>
                <td><span class="code"><%= r.stock_code %></span> <span class="name"><a href="/admin/db-board-dashboard?date=<%= date %>&stockCode=<%= r.stock_code %>"><%= r.stock_name %></a></span></td>
                <td class="num"><strong><%= r.signal_count %></strong></td>
                <td class="num"><%= r.board_count %></td>
                <td class="num pos"><%= r.positive_kind_count %></td>
                <td class="num <%= Number(r.failed_count) > 0 ? 'neg' : '' %>"><%= r.failed_count %></td>
                <td style="font-size:.75rem; color:#64748b;"><%= r.first_signal_date %> → <%= r.last_signal_date %></td>
                <td><% for (const bk of String(r.board_kind_summary || '').split(', ')) { if (!bk) continue; const isNeg = negativeKinds.some(k => bk.endsWith('/'+k)); const isPos = positiveKinds.some(k => bk.endsWith('/'+k)); %><span class="pill <%= isNeg ? 'pill-neg' : isPos ? 'pill-pos' : 'pill-board' %>" title="<%= bk %>"><%= formatBoardKind(bk) %></span><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>

    <!-- 4. 보드별 성과 요약 -->
    <div class="card-soft">
      <h2><i class="bi bi-graph-up"></i>보드별 성과 요약 (최근 <%= days %>일)</h2>
      <div class="hint">고정 6 조합. not_ready outcome 제외. hit_5는 D+horizon 안에 최대 +5% 도달한 비율, fail_5는 −5% 이탈한 비율.</div>
      <% if (errors.performance) { %><div class="err">오류: <%= errors.performance %></div>
      <% } else if (!sections.performance || sections.performance.length === 0) { %><div class="empty">데이터 없음.</div>
      <% } else { %>
        <div class="scroll-wrap"><table class="t">
          <thead>
            <tr>
              <th>board / kind / D+</th>
              <th class="num">n</th>
              <th class="num">avg max_high</th>
              <th class="num">avg close</th>
              <th class="num">hit_5</th>
              <th class="num">hit_10</th>
              <th class="num">hit_20</th>
              <th class="num">fail_5</th>
            </tr>
          </thead>
          <tbody>
            <% sections.performance.forEach(function(r) { %>
              <tr>
                <td><span class="pill pill-board" title="<%= r.board_name %>"><%= formatBoardName(r.board_name) %></span><% if (r.signal_kind) { %> <span class="pill pill-mut" title="<%= r.signal_kind %>"><%= formatSignalKind(r.signal_kind) %></span><% } else { %> <span class="pill pill-mut">전체</span><% } %> <span class="code">D+<%= r.horizon_days %></span></td>
                <% if (r.error || r.sample_count === 0) { %>
                  <td class="num" colspan="7" style="color:#94a3b8;">데이터 부족 <% if (r.error) { %>(<%= r.error %>)<% } %></td>
                <% } else { %>
                  <td class="num"><%= r.sample_count %></td>
                  <td class="num <%= Number(r.avg_max_high_return_pct) >= 5 ? 'pos' : '' %>"><%= r.avg_max_high_return_pct != null ? Number(r.avg_max_high_return_pct).toFixed(2) + '%' : '—' %></td>
                  <td class="num <%= Number(r.avg_close_return_pct) > 0 ? 'pos' : Number(r.avg_close_return_pct) < 0 ? 'neg' : '' %>"><%= r.avg_close_return_pct != null ? Number(r.avg_close_return_pct).toFixed(2) + '%' : '—' %></td>
                  <td class="num"><%= r.hit_5_rate != null ? (Number(r.hit_5_rate) * 100).toFixed(1) + '%' : '—' %></td>
                  <td class="num"><%= r.hit_10_rate != null ? (Number(r.hit_10_rate) * 100).toFixed(1) + '%' : '—' %></td>
                  <td class="num"><%= r.hit_20_rate != null ? (Number(r.hit_20_rate) * 100).toFixed(1) + '%' : '—' %></td>
                  <td class="num <%= Number(r.fail_5_rate) >= 0.3 ? 'neg' : '' %>"><%= r.fail_5_rate != null ? (Number(r.fail_5_rate) * 100).toFixed(1) + '%' : '—' %></td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>

    <!-- 5. link_type 요약 -->
    <div class="card-soft">
      <h2><i class="bi bi-link-45deg"></i>link_type 전환율 (최근 <%= days %>일)</h2>
      <div class="hint">QVA → VVI → 돌파 같은 시퀀스 link 통계. avg_days는 from → to 평균 거래일 간격.</div>
      <% if (errors.linkSummary) { %><div class="err">오류: <%= errors.linkSummary %></div>
      <% } else if (!sections.linkSummary || sections.linkSummary.length === 0) { %><div class="empty">데이터 없음.</div>
      <% } else { %>
        <div class="scroll-wrap"><table class="t">
          <thead>
            <tr><th>link_type</th><th class="num">count</th><th class="num">avg days</th><th class="num">max days</th><th>최근 sample (5건)</th></tr>
          </thead>
          <tbody>
            <% sections.linkSummary.forEach(function(r) { %>
              <tr>
                <td><span class="pill pill-board"><%= r.link_type %></span></td>
                <td class="num"><strong><%= r.link_count %></strong></td>
                <td class="num"><%= r.avg_days_between != null ? Number(r.avg_days_between).toFixed(1) : '—' %></td>
                <td class="num"><%= r.max_days_between != null ? r.max_days_between : '—' %></td>
                <td style="font-size:.75rem;"><% for (const ex of (r.examples || []).slice(0, 5)) { %><span class="pill pill-mut" title="<%= ex.from_kind %> → <%= ex.to_kind %> (Δ<%= ex.days_between %>d) | <%= formatSignalKind(ex.from_kind) %> → <%= formatSignalKind(ex.to_kind) %>"><%= ex.stock_code %> <%= ex.stock_name %></span><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>

    <!-- 6. 사용자 조합 필터 -->
    <div class="card-soft" id="filter-section">
      <h2><i class="bi bi-funnel"></i>사용자 조합 필터</h2>
      <div class="hint">이 필터는 매수 조건이 아니라, 많은 후보 중 <strong>먼저 볼 대상을 좁히기 위한 화면 조건</strong>입니다. 프리셋 선택 또는 단계/보드 체크박스로 조합하세요. matchMode <code>any</code>=하나라도, <code>all</code>=모두 포함.</div>

      <form method="get" action="/db-board#filter-section" style="margin-bottom:14px;">
        <!-- 현재 화면 필터(date/days/limit/stockCode) 유지 -->
        <input type="hidden" name="date"  value="<%= date %>" />
        <input type="hidden" name="days"  value="<%= days %>" />
        <input type="hidden" name="limit" value="<%= limit %>" />
        <% if (stockSearch) { %><input type="hidden" name="stockCode" value="<%= stockSearch %>" /><% } %>

        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-bottom:10px;">
          <!-- 프리셋 -->
          <div>
            <label style="color:#94a3b8; font-size:.78rem; display:block; margin-bottom:4px;">프리셋</label>
            <select name="preset" style="font-size:.85rem; padding:6px 10px; border:1px solid #475569; border-radius:8px; background:#0f172a; color:#e2e8f0; width:100%;">
              <option value="">— 직접 선택 —</option>
              <% for (const k of Object.keys(FILTER_PRESETS)) { %>
                <option value="<%= k %>" <%= filterPreset === k ? 'selected' : '' %>><%= FILTER_PRESETS[k].label %></option>
              <% } %>
            </select>
            <% if (filterPreset && FILTER_PRESETS[filterPreset]) { %>
              <div style="font-size:.72rem; color:#94a3b8; margin-top:4px;"><%= FILTER_PRESETS[filterPreset].description %></div>
            <% } %>
          </div>

          <!-- 보드 선택 -->
          <div>
            <label style="color:#94a3b8; font-size:.78rem; display:block; margin-bottom:4px;">보드 포함 (선택 안 하면 전체)</label>
            <select name="includeBoard" multiple size="4" style="font-size:.82rem; padding:6px 10px; border:1px solid #475569; border-radius:8px; background:#0f172a; color:#e2e8f0; width:100%;">
              <% const incBoards = (filterResolved && filterResolved.includeBoard) || []; %>
              <% for (const [code, label] of Object.entries(BOARD_LABELS)) { %>
                <option value="<%= code %>" <%= incBoards.includes(code) ? 'selected' : '' %>><%= label %> <span style="color:#64748b">(<%= code %>)</span></option>
              <% } %>
            </select>
          </div>

          <!-- matchMode -->
          <div>
            <label style="color:#94a3b8; font-size:.78rem; display:block; margin-bottom:4px;">단계 매칭 방식</label>
            <div style="display:flex; gap:14px; padding:6px 0;">
              <% const mm = (filterResolved && filterResolved.matchMode) || 'any'; %>
              <label style="font-size:.85rem; color:#cbd5e1;"><input type="radio" name="matchMode" value="any" <%= mm === 'any' ? 'checked' : '' %> /> 하나라도 포함</label>
              <label style="font-size:.85rem; color:#cbd5e1;"><input type="radio" name="matchMode" value="all" <%= mm === 'all' ? 'checked' : '' %> /> 모두 포함</label>
            </div>
            <label style="color:#94a3b8; font-size:.72rem; display:block; margin-top:4px;">최소 보드 수
              <input type="number" name="minBoardCount" min="0" max="10" value="<%= filterMinBoardCount %>" style="width:60px; font-size:.82rem; padding:3px 8px; border:1px solid #475569; border-radius:6px; background:#0f172a; color:#e2e8f0; margin-left:6px;" />
            </label>
            <label style="color:#94a3b8; font-size:.72rem; display:block; margin-top:4px;">최소 등장 횟수
              <input type="number" name="minRepeatCount" min="0" max="20" value="<%= filterMinRepeatCount %>" style="width:60px; font-size:.82rem; padding:3px 8px; border:1px solid #475569; border-radius:6px; background:#0f172a; color:#e2e8f0; margin-left:6px;" />
            </label>
          </div>
        </div>

        <!-- 단계(signal_kind) 선택 — 포함 / 제외 -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:10px;">
          <div>
            <label style="color:#94a3b8; font-size:.78rem; display:block; margin-bottom:4px;">포함 단계</label>
            <select name="includeKind" multiple size="7" style="font-size:.82rem; padding:6px 10px; border:1px solid #475569; border-radius:8px; background:#0f172a; color:#e2e8f0; width:100%;">
              <% const incKinds = (filterResolved && filterResolved.includeKind) || []; %>
              <% for (const [code, label] of Object.entries(KIND_LABELS)) { %>
                <option value="<%= code %>" <%= incKinds.includes(code) ? 'selected' : '' %>><%= label %> <span style="color:#64748b">(<%= code %>)</span></option>
              <% } %>
            </select>
          </div>
          <div>
            <label style="color:#94a3b8; font-size:.78rem; display:block; margin-bottom:4px;">제외 단계 (종목 단위)</label>
            <select name="excludeKind" multiple size="7" style="font-size:.82rem; padding:6px 10px; border:1px solid #475569; border-radius:8px; background:#0f172a; color:#e2e8f0; width:100%;">
              <% const excKinds = (filterResolved && filterResolved.excludeKind) || []; %>
              <% for (const [code, label] of Object.entries(KIND_LABELS)) { %>
                <option value="<%= code %>" <%= excKinds.includes(code) ? 'selected' : '' %>><%= label %> <span style="color:#64748b">(<%= code %>)</span></option>
              <% } %>
            </select>
            <div style="font-size:.72rem; color:#94a3b8; margin-top:4px;">한 번이라도 매칭되면 종목 전체를 결과에서 제외</div>
          </div>
        </div>

        <div style="display:flex; gap:8px;">
          <button type="submit" style="font-size:.85rem; padding:6px 14px; border-radius:8px; border:0; background:#2563eb; color:#fff; font-weight:600; cursor:pointer;"><i class="bi bi-funnel-fill me-1"></i>필터 적용</button>
          <a href="/db-board?date=<%= date %>&days=<%= days %>&limit=<%= limit %>" style="font-size:.85rem; padding:6px 14px; border-radius:8px; background:transparent; color:#cbd5e1; border:1px solid #475569; text-decoration:none;">초기화</a>
        </div>
      </form>

      <!-- 결과 표 -->
      <% if (!filterApplied) { %>
        <div class="empty">프리셋을 고르거나 단계/보드를 선택해서 <strong>필터 적용</strong> 버튼을 누르세요.</div>
      <% } else if (errors.filteredSignals) { %>
        <div class="err">필터 오류: <%= errors.filteredSignals %></div>
      <% } else if (!sections.filteredSignals || sections.filteredSignals.length === 0) { %>
        <div class="empty">
          조건에 맞는 종목이 없습니다.
          <% if (sections.filterDiagnostics && sections.filterDiagnostics.length > 0) { %>
            <div style="margin-top:10px; text-align:left; background:#3a2a08; border-left:3px solid #f59e0b; border-radius:6px; padding:10px 12px; color:#fde68a; font-size:.78rem; line-height:1.6;">
              <strong style="color:#fef3c7;">🔍 진단</strong>
              <% for (const issue of sections.filterDiagnostics) { %>
                <div style="margin-top:6px;">• <%= issue.message %></div>
              <% } %>
            </div>
          <% } %>
          <% if (filterResolved && filterResolved.includeBoard && filterResolved.includeBoard.length > 0) { %>
            <div style="margin-top:10px; text-align:left; background:#0f172a; border-radius:6px; padding:10px 12px; color:#94a3b8; font-size:.72rem; line-height:1.6;">
              <strong style="color:#cbd5e1;">선택한 보드의 실제 가능 stage</strong>
              <% for (const b of filterResolved.includeBoard) {
                   const possible = (typeof BOARD_KIND_MATRIX !== 'undefined' && BOARD_KIND_MATRIX[b]) ? BOARD_KIND_MATRIX[b] : [];
              %>
                <div style="margin-top:4px;">
                  <span class="pill pill-board"><%= BOARD_LABELS[b] || b %></span>
                  <% for (const k of possible) { %>
                    <span class="pill pill-mut" title="<%= k %>"><%= KIND_LABELS[k] || k %></span>
                  <% } %>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="meta-row" style="margin-bottom:10px;">
          매칭: <strong><%= sections.filteredSignals.length %></strong>건
          · 모드: <strong><%= filterResolved.matchMode === 'all' ? '모두 포함 (all)' : '하나라도 포함 (any)' %></strong>
          <% if (filterResolved.includeKind && filterResolved.includeKind.length) { %>· 포함: <%= filterResolved.includeKind.map(k => KIND_LABELS[k] || k).join(', ') %><% } %>
          <% if (filterResolved.excludeKind && filterResolved.excludeKind.length) { %>· 제외: <%= filterResolved.excludeKind.map(k => KIND_LABELS[k] || k).join(', ') %><% } %>
          <% if (filterResolved.includeBoard && filterResolved.includeBoard.length) { %>· 보드: <%= filterResolved.includeBoard.map(b => BOARD_LABELS[b] || b).join(', ') %><% } %>
        </div>
        <div class="scroll-wrap"><table class="t">
          <thead>
            <tr>
              <th class="rank">#</th>
              <th>종목</th>
              <th class="num">signals</th>
              <th class="num">boards</th>
              <th class="num">단계점수</th>
              <th class="num">positive</th>
              <th class="num">negative</th>
              <th>기간</th>
              <th>매칭된 보드/단계</th>
            </tr>
          </thead>
          <tbody>
            <% sections.filteredSignals.forEach(function(r, i) { %>
              <tr>
                <td class="rank"><%= i + 1 %></td>
                <td><span class="code"><%= r.stock_code %></span> <span class="name"><a href="/db-board?date=<%= date %>&stockCode=<%= r.stock_code %>"><%= r.stock_name %></a></span></td>
                <td class="num"><strong><%= r.signal_count %></strong></td>
                <td class="num"><%= r.board_count %></td>
                <td class="num <%= Number(r.stage_score || 0) > 0 ? 'pos' : Number(r.stage_score || 0) < 0 ? 'neg' : '' %>"><%= r.stage_score != null ? r.stage_score : '—' %></td>
                <td class="num pos"><%= r.positive_kind_count %></td>
                <td class="num <%= Number(r.negative_kind_count) > 0 ? 'neg' : '' %>"><%= r.negative_kind_count %></td>
                <td style="font-size:.75rem; color:#94a3b8;"><%= r.first_signal_date %> → <%= r.last_signal_date %></td>
                <td><% for (const bk of String(r.raw_boards || '').split(', ')) { if (!bk) continue; const isNeg = negativeKinds.some(k => bk.endsWith('/'+k)); const isPos = positiveKinds.some(k => bk.endsWith('/'+k)); %><span class="pill <%= isNeg ? 'pill-neg' : isPos ? 'pill-pos' : 'pill-board' %>" title="<%= bk %>"><%= formatBoardKind(bk) %></span><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>

    <div style="text-align:center; color:#94a3b8; font-size:.78rem; margin:24px 0;">
      <i class="bi bi-info-circle"></i> 이 화면은 매수 신호가 아닙니다. DB에 누적된 보드 신호를 관리자가 빠르게 훑어보기 위한 요약입니다.
    </div>
  </div>
</body>
</html>
