<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DB 신호 검색</title>
  <style>
    :root {
      --bg: #0f172a;
      --panel: #111827;
      --panel-2: #1f2937;
      --border: #1f2937;
      --border-strong: #374151;
      --text: #e5e7eb;
      --text-dim: #9ca3af;
      --text-muted: #6b7280;
      --accent: #60a5fa;
      --accent-strong: #3b82f6;
      --good: #34d399;
      --warn: #fbbf24;
      --bad: #f87171;
      --shadow: 0 4px 16px rgba(0,0,0,0.35);
    }
    * { box-sizing: border-box; }
    html, body { margin:0; padding:0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 16px;
    }
    header.intro {
      padding: 24px 8px 16px;
    }
    header.intro h1 {
      margin: 0 0 8px;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }
    header.intro .lead {
      color: var(--text-dim);
      font-size: 13px;
      line-height: 1.7;
    }
    header.intro .lead b { color: #d1d5db; }

    /* ── 검색창 ───────────────────── */
    .search-wrap {
      position: relative;
      margin: 12px 0 20px;
    }
    .search-input {
      width: 100%;
      padding: 16px 48px 16px 20px;
      background: var(--panel-2);
      border: 1px solid var(--border-strong);
      border-radius: 12px;
      color: var(--text);
      font-size: 17px;
      outline: none;
      transition: border-color 0.15s;
    }
    .search-input:focus { border-color: var(--accent-strong); }
    .search-input::placeholder { color: var(--text-muted); font-size: 15px; }
    .search-icon {
      position: absolute;
      right: 16px; top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 18px;
      pointer-events: none;
    }
    .suggest-dropdown {
      position: absolute;
      top: calc(100% + 4px);
      left: 0; right: 0;
      background: var(--panel-2);
      border: 1px solid var(--border-strong);
      border-radius: 10px;
      box-shadow: var(--shadow);
      max-height: 380px;
      overflow-y: auto;
      z-index: 50;
      display: none;
    }
    .suggest-dropdown.open { display: block; }
    .suggest-item {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px;
      padding: 10px 14px;
      cursor: pointer;
      border-bottom: 1px solid var(--border);
      transition: background 0.1s;
    }
    .suggest-item:last-child { border-bottom: none; }
    .suggest-item:hover, .suggest-item.focused { background: #1e293b; }
    .suggest-item .name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }
    .suggest-item .code {
      font-size: 11px;
      color: var(--text-muted);
      margin-left: 6px;
    }
    .suggest-item .meta {
      font-size: 11px;
      color: var(--text-dim);
      text-align: right;
      align-self: end;
    }
    .suggest-item .boards-mini {
      grid-column: 1 / -1;
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 3px;
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }

    /* ── 추천 영역 ─────────────────── */
    .recent-section {
      margin: 16px 0 24px;
    }
    .recent-section .recent-title {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .recent-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .recent-chip {
      padding: 6px 10px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      font-size: 12px;
      cursor: pointer;
      transition: border-color 0.1s, background 0.1s;
      color: var(--text);
    }
    .recent-chip:hover { border-color: var(--accent); background: #1e293b; }
    .recent-chip .code-mini { color: var(--text-muted); margin-left: 4px; font-size: 11px; }
    .recent-chip .date-mini { color: var(--text-muted); margin-left: 6px; font-size: 11px; }

    /* ── 결과 영역 ─────────────────── */
    .result-area { margin-top: 16px; }
    .result-empty {
      padding: 60px 20px;
      text-align: center;
      color: var(--text-muted);
      font-size: 14px;
    }

    .summary-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
    }
    .summary-head { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
    .summary-head .stock-name {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
    }
    .summary-head .stock-code {
      font-size: 13px;
      color: var(--text-muted);
      font-family: ui-monospace, SFMono-Regular, monospace;
    }
    .summary-head .market-tag {
      padding: 2px 8px;
      background: #374151;
      border-radius: 4px;
      font-size: 11px;
      color: #d1d5db;
    }
    .summary-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }
    .stat {
      background: var(--panel-2);
      border-radius: 8px;
      padding: 10px 12px;
    }
    .stat .label { font-size: 11px; color: var(--text-muted); margin-bottom: 3px; }
    .stat .value { font-size: 16px; font-weight: 600; color: var(--text); }
    .stat .sub { font-size: 11px; color: var(--text-dim); margin-top: 2px; }

    .breakdown {
      margin-top: 16px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    @media (max-width: 600px) { .breakdown { grid-template-columns: 1fr; } }
    .breakdown h4 {
      margin: 0 0 6px;
      font-size: 12px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-list { display: flex; flex-wrap: wrap; gap: 4px; }
    .badge {
      padding: 3px 8px;
      background: var(--panel-2);
      border: 1px solid var(--border-strong);
      border-radius: 12px;
      font-size: 11px;
      color: var(--text);
    }
    .badge .n { color: var(--text-muted); font-size: 10px; margin-left: 4px; }
    .badge.b-qva { border-color: #2563eb; color: #93c5fd; }
    .badge.b-qva2 { border-color: #7c3aed; color: #c4b5fd; }
    .badge.b-vvi { border-color: #16a34a; color: #86efac; }
    .badge.b-rebreak { border-color: #f59e0b; color: #fcd34d; }
    .badge.b-1ds { border-color: #ec4899; color: #f9a8d4; }

    .kind-badge {
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 11px;
      background: #1e293b;
      color: var(--text);
      border: 1px solid var(--border-strong);
      white-space: nowrap;
    }
    .kind-badge.k-positive { background: #064e3b; border-color: #047857; color: #6ee7b7; }
    .kind-badge.k-negative { background: #450a0a; border-color: #991b1b; color: #fca5a5; }
    .kind-badge.k-neutral  { background: #1e293b; border-color: #475569; color: #cbd5e1; }

    /* ── 신호 이력 테이블 ─────────────── */
    .signals-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 0 4px;
    }
    .signals-card h3 {
      margin: 0 16px 12px;
      font-size: 14px;
      color: var(--text-dim);
    }
    .signals-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12.5px;
    }
    .signals-table th, .signals-table td {
      text-align: left;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
    }
    .signals-table th {
      font-weight: 600;
      color: var(--text-muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      background: #0c1322;
    }
    .signals-table td.code { font-family: ui-monospace, SFMono-Regular, monospace; color: var(--text-dim); }
    .signals-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .signals-table tr:hover td { background: #131c2e; }

    @media (max-width: 700px) {
      .signals-table th.hide-sm, .signals-table td.hide-sm { display: none; }
    }
    @media (max-width: 480px) {
      .signals-table th.hide-xs, .signals-table td.hide-xs { display: none; }
    }

    /* ── 멀티 결과 ────────────────────── */
    .multi-match-list {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
    }
    .multi-match-list .mm-row {
      padding: 10px 12px;
      border-radius: 8px;
      cursor: pointer;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 6px;
    }
    .multi-match-list .mm-row:hover { background: #1e293b; }
    .multi-match-list .mm-row .left .name { font-weight: 600; }
    .multi-match-list .mm-row .left .code { color: var(--text-muted); font-size: 11px; margin-left: 6px; }
    .multi-match-list .mm-row .meta { font-size: 11px; color: var(--text-dim); align-self: end; text-align: right; }
    .multi-match-list .mm-row .boards { grid-column: 1 / -1; margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px; }

    .info-note {
      padding: 10px 14px;
      background: #0c1322;
      border-left: 3px solid var(--text-muted);
      border-radius: 4px;
      color: var(--text-dim);
      font-size: 12px;
      margin: 14px 0;
    }
    .loading {
      text-align: center;
      padding: 30px;
      color: var(--text-muted);
      font-size: 13px;
    }
    .error-box {
      background: #450a0a;
      border: 1px solid #991b1b;
      color: #fca5a5;
      padding: 12px 14px;
      border-radius: 8px;
      margin: 12px 0;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <%- navHtml %>

  <div class="container">
    <header class="intro">
      <h1>🔎 DB 신호 검색</h1>
      <p class="lead">
        저장된 보드 신호를 <b>종목명 또는 종목코드</b>로 검색합니다.<br>
        이 화면은 매수 신호가 아니라, 과거에 어떤 보드에 포착되었는지 확인하는 용도입니다.
      </p>
    </header>

    <div class="search-wrap">
      <input
        id="search-input"
        class="search-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="종목명 또는 종목코드 입력  예: KG스틸, 016380, 칩스"
        value="<%= initialQ || '' %>" />
      <span class="search-icon">🔍</span>
      <div id="suggest-dropdown" class="suggest-dropdown" role="listbox"></div>
    </div>

    <div class="recent-section" id="recent-section">
      <div class="recent-title">최근 신호 종목 (클릭하면 검색)</div>
      <div class="recent-chips" id="recent-chips">
        <% (initialSuggestions || []).forEach(function(s) { %>
          <span class="recent-chip"
                data-code="<%= s.stock_code %>"
                data-name="<%= s.stock_name %>"
                title="<%= s.board_names %>">
            <%= s.stock_name %><span class="code-mini"><%= s.stock_code %></span>
            <span class="date-mini"><%= String(s.latest_signal_date || '').slice(0,10) %></span>
          </span>
        <% }); %>
        <% if (initialError) { %>
          <span class="recent-chip" style="border-color:#991b1b;color:#fca5a5;">DB 연결 실패: <%= initialError %></span>
        <% } %>
      </div>
    </div>

    <div class="result-area" id="result-area">
      <div class="result-empty" id="empty-msg">
        위 검색창에 종목명 또는 코드를 입력하세요.
      </div>
    </div>

    <div class="info-note">
      ⓘ 이 화면은 board_signals 테이블만 조회합니다. 매수/매도 추천이 아닙니다. 같은 종목이 여러 보드에 잡혔는지, 언제 잡혔는지 확인하는 용도입니다.
    </div>
  </div>

<script>
  // ─── 라벨 매핑 (서버에서 inject) ───────────────────────────────────────
  const BOARD_LABELS = <%- JSON.stringify(BOARD_LABELS || {}) %>;
  const KIND_LABELS  = <%- JSON.stringify(KIND_LABELS  || {}) %>;
  const POSITIVE_KINDS = new Set([
    'VVI_FIRED','VVI2_FIRED','BREAKOUT_SUCCESS','TODAY_INITIAL_BREAKOUT',
    'CLOSE_REBREAK','CLOSE_REBREAK_NO_BREACH','CLOSE_REBREAK_VOL_EXPLOSION','CLOSE_REBREAK_HOLD_NEXTDAY','CLOSE_REBREAK_BREACH_RECOVER',
    'TODAY_NEW_VVI','TODAY_NEW_VVI2','ATTACK_TOP','QVA_NEW','QVA2_NEW',
  ]);
  const NEGATIVE_KINDS = new Set(['FAILED','BROKEN','BREACH_NO_RECOVER','BREACH_RECOVER_ILLUSION','NO_REBREAK','INTRADAY_PUSHBACK','OVERHEATED']);
  function boardLabel(b) { return BOARD_LABELS[b] || b; }
  function kindLabel(k)  { return KIND_LABELS[k]  || k; }
  function kindTone(k) {
    if (POSITIVE_KINDS.has(k)) return 'k-positive';
    if (NEGATIVE_KINDS.has(k)) return 'k-negative';
    return 'k-neutral';
  }
  function boardClass(b) {
    if (b.startsWith('QVA2')) return 'b-qva2';
    if (b.startsWith('QVA'))  return 'b-qva';
    if (b.includes('VVI'))    return 'b-vvi';
    if (b.includes('REBREAK')) return 'b-rebreak';
    if (b === 'ONE_DAY_SURGE') return 'b-1ds';
    return '';
  }
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function fmtDate(d) { return d ? String(d).slice(0,10) : '-'; }
  function fmtNum(n) {
    if (n == null) return '-';
    const v = Number(n);
    if (!isFinite(v)) return '-';
    return v.toLocaleString('ko-KR');
  }

  // ─── DOM helpers ─────────────────────────────────────────────────────
  const $ = (sel) => document.querySelector(sel);
  const searchInput   = $('#search-input');
  const dropdown      = $('#suggest-dropdown');
  const resultArea    = $('#result-area');
  const emptyMsg      = $('#empty-msg');
  const recentSection = $('#recent-section');

  let suggestTimer = null;
  let lastQuery = '';
  let focusedSuggestIdx = -1;
  let currentSuggestions = [];

  // ─── 자동완성 ─────────────────────────────────────────────────────────
  async function fetchSuggest(q) {
    try {
      const url = '/admin/db-signals/suggest?q=' + encodeURIComponent(q || '') + '&limit=15';
      const res = await fetch(url, { credentials: 'same-origin' });
      if (!res.ok) return [];
      const j = await res.json();
      return j.suggestions || [];
    } catch (_) { return []; }
  }
  function renderSuggest(rows) {
    currentSuggestions = rows || [];
    focusedSuggestIdx = -1;
    if (!rows || rows.length === 0) {
      dropdown.innerHTML = '<div style="padding:14px 16px;color:#6b7280;font-size:13px;">일치하는 종목이 없습니다.</div>';
      dropdown.classList.add('open');
      return;
    }
    let html = '';
    for (let i = 0; i < rows.length; i++) {
      const s = rows[i];
      const boardChips = String(s.board_names || '').split(', ').filter(Boolean)
        .map(b => '<span class="badge ' + boardClass(b) + '">' + esc(boardLabel(b)) + '</span>').join('');
      html += '<div class="suggest-item" data-idx="' + i + '" data-code="' + esc(s.stock_code) + '" data-name="' + esc(s.stock_name) + '">' +
        '<div><span class="name">' + esc(s.stock_name) + '</span><span class="code">' + esc(s.stock_code) + '</span></div>' +
        '<div class="meta">' + fmtDate(s.latest_signal_date) + ' · ' + s.signal_count + '건 · ' + s.board_count + '보드</div>' +
        '<div class="boards-mini">' + boardChips + '</div>' +
        '</div>';
    }
    dropdown.innerHTML = html;
    dropdown.classList.add('open');
  }
  function closeDropdown() {
    dropdown.classList.remove('open');
    focusedSuggestIdx = -1;
  }
  function focusSuggest(idx) {
    const items = dropdown.querySelectorAll('.suggest-item');
    items.forEach(el => el.classList.remove('focused'));
    if (idx >= 0 && idx < items.length) {
      items[idx].classList.add('focused');
      items[idx].scrollIntoView({ block: 'nearest' });
      focusedSuggestIdx = idx;
    } else {
      focusedSuggestIdx = -1;
    }
  }

  // ─── 검색 실행 ────────────────────────────────────────────────────────
  async function runSearch(stockCode, stockName) {
    closeDropdown();
    recentSection.style.display = 'none';
    emptyMsg.style.display = 'none';
    resultArea.innerHTML = '<div class="loading">불러오는 중…</div>';
    try {
      if (stockCode && /^\d{4,6}$/.test(stockCode)) {
        const sumRes = await fetch('/admin/db-signals/summary/' + encodeURIComponent(stockCode), { credentials: 'same-origin' });
        if (!sumRes.ok) { resultArea.innerHTML = '<div class="error-box">조회 실패 (HTTP ' + sumRes.status + ')</div>'; return; }
        const sum = await sumRes.json();
        renderStockResult(sum);
        history.replaceState(null, '', '/db-board?q=' + encodeURIComponent(stockCode));
      } else {
        const kw = (stockName || stockCode || '').trim();
        if (!kw) { resultArea.innerHTML = ''; emptyMsg.style.display = 'block'; recentSection.style.display = ''; return; }
        const searchRes = await fetch('/admin/db-signals/search?q=' + encodeURIComponent(kw) + '&limit=300', { credentials: 'same-origin' });
        if (!searchRes.ok) { resultArea.innerHTML = '<div class="error-box">조회 실패 (HTTP ' + searchRes.status + ')</div>'; return; }
        const data = await searchRes.json();
        if (!data.stocks || data.stocks.length === 0) {
          resultArea.innerHTML = '<div class="result-empty">"' + esc(kw) + '" 에 해당하는 종목을 찾지 못했습니다.</div>';
          return;
        }
        if (data.stocks.length === 1) {
          const code = data.stocks[0].stock_code;
          const sumRes2 = await fetch('/admin/db-signals/summary/' + encodeURIComponent(code), { credentials: 'same-origin' });
          if (sumRes2.ok) {
            const sum = await sumRes2.json();
            renderStockResult(sum);
            history.replaceState(null, '', '/db-board?q=' + encodeURIComponent(code));
            return;
          }
        }
        renderMultiMatch(data);
      }
    } catch (e) {
      resultArea.innerHTML = '<div class="error-box">조회 중 오류: ' + esc(e.message || e) + '</div>';
    }
  }

  // ─── 결과 렌더링 (단일 종목) ────────────────────────────────────────
  function renderStockResult(sum) {
    if (!sum || sum.total_signal_count === 0) {
      resultArea.innerHTML = '<div class="result-empty">해당 종목의 신호 기록이 없습니다.</div>';
      return;
    }
    const kindBadges = (sum.kind_breakdown || []).map(k =>
      '<span class="kind-badge ' + kindTone(k.signal_kind) + '" title="' + esc(k.signal_kind) + ': ' + k.n + '건 (' + fmtDate(k.first_date) + ' ~ ' + fmtDate(k.last_date) + ')">' + esc(kindLabel(k.signal_kind)) + '<span class="n">' + k.n + '</span></span>'
    ).join(' ');

    const boardBadges = (sum.board_breakdown || []).map(b =>
      '<span class="badge ' + boardClass(b.board_name) + '" title="' + esc(b.board_name) + '">' + esc(boardLabel(b.board_name)) + '<span class="n">' + b.n + '</span></span>'
    ).join(' ');

    const marketTag = sum.market ? '<span class="market-tag">' + esc(sum.market) + '</span>' : '';

    let html =
      '<div class="summary-card">' +
        '<div class="summary-head">' +
          '<div class="stock-name">' + esc(sum.stock_name || '-') + '</div>' +
          '<div class="stock-code">' + esc(sum.stock_code) + '</div>' +
          marketTag +
        '</div>' +
        '<div class="summary-stats">' +
          '<div class="stat"><div class="label">총 신호</div><div class="value">' + sum.total_signal_count + '건</div></div>' +
          '<div class="stat"><div class="label">등장 보드</div><div class="value">' + sum.board_count + '개</div></div>' +
          '<div class="stat"><div class="label">신호 종류</div><div class="value">' + sum.kind_count + '개</div></div>' +
          '<div class="stat"><div class="label">최근 신호일</div><div class="value">' + fmtDate(sum.latest_signal_date) + '</div></div>' +
          '<div class="stat"><div class="label">최초 신호일</div><div class="value">' + fmtDate(sum.first_signal_date) + '</div></div>' +
        '</div>' +
        '<div class="breakdown">' +
          '<div><h4>등장 보드</h4><div class="badge-list">' + (boardBadges || '<span style="color:#6b7280;">없음</span>') + '</div></div>' +
          '<div><h4>신호 종류</h4><div class="badge-list">' + (kindBadges || '<span style="color:#6b7280;">없음</span>') + '</div></div>' +
        '</div>' +
      '</div>';

    const rows = (sum.latest_signals || []).map(s => {
      const date = fmtDate(s.signal_date);
      const board = '<span class="badge ' + boardClass(s.board_name) + '" title="' + esc(s.board_name) + '">' + esc(boardLabel(s.board_name)) + '</span>';
      const kind = '<span class="kind-badge ' + kindTone(s.signal_kind) + '" title="' + esc(s.signal_kind) + '">' + esc(kindLabel(s.signal_kind)) + '</span>';
      const price = s.signal_price != null ? fmtNum(s.signal_price) : '-';
      const close = s.signal_close != null ? fmtNum(s.signal_close) : '-';
      const score = s.score != null ? Number(s.score).toFixed(1) : '-';
      const grade = s.grade || '-';
      const src = s.source_type || '-';
      const status = s.status_label || '-';
      return '<tr>' +
        '<td>' + date + '</td>' +
        '<td>' + board + '</td>' +
        '<td>' + kind + '</td>' +
        '<td class="num">' + price + '</td>' +
        '<td class="num hide-sm">' + close + '</td>' +
        '<td class="num hide-xs">' + score + '</td>' +
        '<td class="hide-xs">' + esc(grade) + '</td>' +
        '<td class="hide-sm">' + esc(status) + '</td>' +
        '<td class="hide-sm" style="color:#6b7280;font-size:11px;">' + esc(src) + '</td>' +
        '</tr>';
    }).join('');

    html +=
      '<div class="signals-card">' +
        '<h3>최근 신호 ' + (sum.latest_signals ? sum.latest_signals.length : 0) + '건 (전체 ' + sum.total_signal_count + '건 중)</h3>' +
        '<table class="signals-table">' +
          '<thead><tr>' +
            '<th>날짜</th><th>보드</th><th>신호</th>' +
            '<th class="num">기준가</th>' +
            '<th class="num hide-sm">종가</th>' +
            '<th class="num hide-xs">점수</th>' +
            '<th class="hide-xs">등급</th>' +
            '<th class="hide-sm">상태</th>' +
            '<th class="hide-sm">출처</th>' +
          '</tr></thead>' +
          '<tbody>' + rows + '</tbody>' +
        '</table>' +
      '</div>';
    resultArea.innerHTML = html;
  }

  // ─── 결과 렌더링 (다건 매치) ────────────────────────────────────────
  function renderMultiMatch(data) {
    let html = '<div class="info-note">"' + esc(data.q) + '" 검색 — 매칭 종목 ' + data.stocks.length + '개. 종목을 선택하세요.</div>';
    html += '<div class="multi-match-list">';
    for (const s of data.stocks) {
      const boardChips = String(s.board_names || '').split(', ').filter(Boolean)
        .map(b => '<span class="badge ' + boardClass(b) + '">' + esc(boardLabel(b)) + '</span>').join('');
      html += '<div class="mm-row" data-code="' + esc(s.stock_code) + '" data-name="' + esc(s.stock_name) + '">' +
        '<div class="left"><span class="name">' + esc(s.stock_name) + '</span><span class="code">' + esc(s.stock_code) + '</span></div>' +
        '<div class="meta">' + fmtDate(s.latest_signal_date) + ' · ' + s.signal_count + '건 · ' + s.board_count + '보드</div>' +
        '<div class="boards">' + boardChips + '</div>' +
        '</div>';
    }
    html += '</div>';
    resultArea.innerHTML = html;
  }

  // ─── Event handlers ──────────────────────────────────────────────────
  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim();
    lastQuery = q;
    if (suggestTimer) clearTimeout(suggestTimer);
    suggestTimer = setTimeout(async () => {
      if (q.length === 0) { closeDropdown(); return; }
      const rows = await fetchSuggest(q);
      if (q !== lastQuery) return;
      renderSuggest(rows);
    }, 200);
  });
  searchInput.addEventListener('focus', async () => {
    const q = searchInput.value.trim();
    if (q.length === 0) return;
    const rows = await fetchSuggest(q);
    renderSuggest(rows);
  });
  searchInput.addEventListener('keydown', (e) => {
    if (!dropdown.classList.contains('open')) {
      if (e.key === 'Enter') {
        const q = searchInput.value.trim();
        if (q) runSearch(/^\d{4,6}$/.test(q) ? q : null, q);
      }
      return;
    }
    const items = dropdown.querySelectorAll('.suggest-item');
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      focusSuggest((focusedSuggestIdx + 1) % items.length);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      focusSuggest((focusedSuggestIdx - 1 + items.length) % items.length);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (focusedSuggestIdx >= 0 && currentSuggestions[focusedSuggestIdx]) {
        const s = currentSuggestions[focusedSuggestIdx];
        searchInput.value = s.stock_name;
        runSearch(s.stock_code, s.stock_name);
      } else {
        const q = searchInput.value.trim();
        if (q) runSearch(/^\d{4,6}$/.test(q) ? q : null, q);
      }
    } else if (e.key === 'Escape') {
      closeDropdown();
    }
  });

  dropdown.addEventListener('click', (e) => {
    const item = e.target.closest('.suggest-item');
    if (!item) return;
    const code = item.getAttribute('data-code');
    const name = item.getAttribute('data-name');
    searchInput.value = name;
    runSearch(code, name);
  });

  document.getElementById('recent-chips').addEventListener('click', (e) => {
    const chip = e.target.closest('.recent-chip');
    if (!chip) return;
    const code = chip.getAttribute('data-code');
    const name = chip.getAttribute('data-name');
    if (!code) return;
    searchInput.value = name || code;
    runSearch(code, name);
  });

  resultArea.addEventListener('click', (e) => {
    const mm = e.target.closest('.mm-row');
    if (!mm) return;
    const code = mm.getAttribute('data-code');
    const name = mm.getAttribute('data-name');
    if (!code) return;
    searchInput.value = name || code;
    runSearch(code, name);
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-wrap')) closeDropdown();
  });

  // 초기 URL ?q=... 또는 ?stockCode=... 이 있으면 자동 검색
  (function() {
    const q = <%- JSON.stringify(initialQ || '') %>;
    if (q && q.length > 0) {
      runSearch(/^\d{4,6}$/.test(q) ? q : null, q);
    } else {
      searchInput.focus();
    }
  })();
</script>
</body>
</html>
