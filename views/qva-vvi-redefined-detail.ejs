    <div class="info-value <%= i === 0 ? 'pos' : '' %>" style="font-weight:<%= i === 0 ? '700' : '500' %>;"><%= it.rateEnd != null ? Number(it.rateEnd).toFixed(2) + '%' : '-' %></div>
    <% }) %>
  </div>
  <% if (shareholders.topShareholder && shareholders.topShareholder.name) { %>
  <div style="margin-top:8px;font-size:11.5px;color:#5eead4;background:#042f2e;padding:8px 12px;border-radius:5px;border-left:3px solid #14b8a6;">
    🏆 <strong>최대주주: <%= shareholders.topShareholder.name %></strong>
    (<%= Number(shareholders.topShareholder.rateEnd).toFixed(2) %>% · <%= Number(shareholders.topShareholder.sharesEnd).toLocaleString() %>주)
