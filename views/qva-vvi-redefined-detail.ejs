<%
function fmtNum(v) { return v != null ? Math.round(Number(v)).toLocaleString() : '-'; }
function fmtDate(d) { if (!d || String(d).length !== 8) return d || '-'; return String(d).slice(0,4)+'-'+String(d).slice(4,6)+'-'+String(d).slice(6,8); }
function fmtPct(v, prec) {
  if (v == null) return '-';
  prec = prec == null ? 2 : prec;
  return (v > 0 ? '+' : '') + Number(v).toFixed(prec) + '%';
}
function fmtMarketCap(won) {
  if (!won || won <= 0) return '-';
  const eok = won / 1e8;
  if (eok >= 10000) return (eok / 10000).toFixed(2) + '조';
  return Math.round(eok).toLocaleString() + '억';
}
function fmtMoney(won) {
  if (!won || won === 0) return '-';
  const v = Number(won);
  if (v >= 1e12) return (v/1e12).toFixed(2) + '조';
  if (v >= 1e8)  return (v/1e8).toFixed(1) + '억';
  if (v >= 1e4)  return (v/1e4).toFixed(0) + '만';
  return Math.round(v).toLocaleString();
}
const rows = chartRows || [];
const lastRow = rows.length > 0 ? rows[rows.length - 1] : null;
const dispPrice = (kisLive && kisLive.price) || (lastRow && lastRow.close);
const dispChg = (kisLive && kisLive.changeRate != null) ? kisLive.changeRate : null;
%>
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title><%= meta.name %> · 새 VVI 종목 상세</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- TradingView Lightweight Charts (v4) — 캔들·MA·히스토그램·crosshair 지원 -->
<script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
<style>
* { box-sizing: border-box; }
body { margin: 0 auto; padding: 18px 24px 80px; max-width: 1200px;
  font-family: -apple-system, "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
  background: #0f172a; color: #e2e8f0; font-size: 13px;
}
nav { display:flex; gap:10px; flex-wrap:wrap; padding:8px 0 14px; border-bottom:1px solid #1e293b; margin-bottom:14px; font-size: 12px; }
nav a { color:#94a3b8; text-decoration:none; padding:4px 8px; border-radius:4px; }
nav a:hover { color:#e2e8f0; background:#1e293b; }
nav a.back { color: #5eead4; }
h1 { font-size: 24px; margin: 0 0 4px; color: #f1f5f9; font-weight: 700; }
h1 .code { color: #64748b; font-size: 16px; font-weight: 400; margin-left: 8px; }
h2 { font-size: 16px; margin: 22px 0 10px; color: #cbd5e1; }
.subtitle { font-size: 13px; color: #94a3b8; margin-bottom: 14px; }

.price-block { background: #1e293b; border-radius: 10px; padding: 16px 20px; margin-bottom: 14px; border-left: 4px solid #14b8a6; }
.price-row { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.price-big { font-size: 32px; font-weight: 700; color: #f1f5f9; font-variant-numeric: tabular-nums; }
.price-unit { font-size: 14px; font-weight: 400; color: #94a3b8; margin-left: 2px; }
.price-change { font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums; }
.price-change.pos { color: #fca5a5; }   /* 한국 관습: 상승 = 빨강 */
.price-change.neg { color: #93c5fd; }   /* 하락 = 파랑 */
.price-meta { color: #94a3b8; font-size: 12px; margin-top: 6px; }
.price-meta .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; background: #0f172a; border: 1px solid #334155; margin-right: 4px; font-size: 11px; }
.price-meta .badge.live { background: #064e3b; color: #6ee7b7; border-color: #10b981; font-weight: 600; }
.price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 14px; }
.price-cell { background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 10px 12px; }
.price-cell .label { font-size: 11px; color: #94a3b8; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.3px; }
.price-cell .value { font-size: 16px; font-weight: 600; color: #e2e8f0; font-variant-numeric: tabular-nums; }

/* ── 메인 차트 카드 (KIS MTS 느낌의 흰 카드) ── */
.chart-card {
  background: #ffffff; color: #1f2937;
  border-radius: 12px; padding: 14px 16px;
  margin-bottom: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.35);
}
.chart-info-bar {
  display: flex; flex-wrap: wrap; gap: 10px 14px;
  align-items: baseline;
  padding-bottom: 10px; margin-bottom: 8px;
  border-bottom: 1px solid #e5e7eb;
  font-size: 12px; color: #4b5563;
  font-variant-numeric: tabular-nums;
}
.chart-info-bar .ci-name { font-size: 14px; font-weight: 700; color: #111827; }
.chart-info-bar .ci-code { color: #9ca3af; font-size: 11px; margin-left: 4px; }
.chart-info-bar .ci-mkt { font-size: 10px; padding: 1px 6px; border: 1px solid #d1d5db; border-radius: 3px; color: #6b7280; }
.chart-info-bar .ci-date { color: #6b7280; }
.chart-info-bar .ci-ohlc strong, .chart-info-bar .ci-volval strong { color: #1f2937; font-weight: 600; }
.chart-info-bar .ci-chg.pos { color: #ef4444; font-weight: 600; }   /* 상승 빨강 */
.chart-info-bar .ci-chg.neg { color: #3b82f6; font-weight: 600; }   /* 하락 파랑 */

.ma-legend { display: flex; gap: 6px; flex-wrap: wrap; padding-bottom: 10px; font-size: 11px; }
.ma-legend label { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; user-select: none;
  padding: 3px 9px; border-radius: 4px; background: #f9fafb; border: 1px solid #e5e7eb;
  font-variant-numeric: tabular-nums; }
.ma-legend label.off { opacity: 0.4; }
.ma-legend .dot { width: 10px; height: 2px; display: inline-block; }
.ma-legend .ma-label { font-weight: 600; }
.ma-legend .ma-value { color: #6b7280; }

.period-tabs { display: flex; gap: 4px; flex-wrap: wrap; padding-bottom: 10px; }
.period-tabs button {
  background: #f3f4f6; border: 1px solid #e5e7eb; color: #4b5563;
  padding: 5px 14px; border-radius: 4px; font-size: 11.5px; cursor: pointer; font-weight: 500;
}
.period-tabs button:hover { background: #e5e7eb; }
.period-tabs button.active { background: #1f2937; color: #fff; border-color: #1f2937; }

.pane-label { font-size: 10px; color: #9ca3af; padding: 2px 0; font-weight: 600; letter-spacing: 0.3px; }
.chart-pane { position: relative; background: #ffffff; }
.chart-pane.price  { height: 380px; }
.chart-pane.volume { height: 100px; }
.chart-pane.value  { height: 100px; }

/* ── funnel / 재무 / AI / 뉴스 / 공시 ── */
.member-section { background: #1e293b; border-radius: 10px; padding: 14px 18px; margin-bottom: 12px; border-left: 4px solid #14b8a6; }
.member-section h3 { font-size: 13px; margin: 0 0 8px; color: #cbd5e1; font-weight: 600; }
.member-row { font-size: 12px; color: #94a3b8; line-height: 1.7; }
.member-row .stage { display: inline-block; padding: 2px 8px; border-radius: 4px; background: #042f2e; color: #5eead4; margin-right: 4px; font-size: 11px; font-weight: 600; }
.member-row .stage.strong { background: #7f1d1d; color: #fca5a5; }
.member-row .stage.valueInsuf { background: #422006; color: #fde68a; }
.member-row .stage.waiting { background: #1e293b; color: #cbd5e1; border: 1px solid #475569; }

.fin-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; }
.fin-cell { background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 10px 12px; border-left: 3px solid #38bdf8; }
.fin-cell .label { font-size: 11px; color: #94a3b8; margin-bottom: 4px; }
.fin-cell .value { font-size: 16px; font-weight: 600; color: #e2e8f0; font-variant-numeric: tabular-nums; }
.fin-cell .growth { font-size: 12px; margin-top: 4px; font-variant-numeric: tabular-nums; font-weight: 600; }
.fin-cell .growth.pos { color: #fca5a5; }   /* 상승 = 빨강 */
.fin-cell .growth.neg { color: #93c5fd; }
.fin-cell .sub { font-size: 10px; color: #64748b; margin-top: 2px; }

.list-card { background: #1e293b; border-radius: 10px; padding: 14px 18px; margin-bottom: 12px; }
.list-card h2 { margin: 0 0 10px; }
.list-item { padding: 8px 0; border-bottom: 1px solid #334155; font-size: 12px; line-height: 1.6; }
.list-item:last-child { border-bottom: none; }
.list-item .meta { color: #64748b; font-size: 11px; margin-bottom: 2px; }
.list-item .meta .source { color: #94a3b8; margin-right: 6px; }
.list-item .title { color: #e2e8f0; font-weight: 500; }
.list-item .title a { color: #38bdf8; text-decoration: none; }
.list-item .title a:hover { text-decoration: underline; }
.list-item .body { color: #94a3b8; font-size: 11.5px; margin-top: 3px; }

.empty-msg { padding: 12px; background: #1e293b; border-radius: 6px; color: #94a3b8; font-size: 12px; }

/* AI 분석 영역 */
.ai-section { background: linear-gradient(135deg, #1e1b4b 0%, #1e293b 100%); border-radius: 10px; padding: 18px 20px; margin-top: 16px; margin-bottom: 16px; border: 1px solid #4338ca; }
.ai-section h2 { color: #c7d2fe; margin: 0 0 10px; }
.ai-btn { background: #4f46e5; color: #fff; border: none; padding: 10px 22px; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.ai-btn:hover { background: #6366f1; }
.ai-btn:disabled { background: #4338ca; opacity: 0.6; cursor: not-allowed; }
.ai-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid #c7d2fe; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: middle; margin-right: 8px; }
@keyframes spin { to { transform: rotate(360deg); } }
.ai-result { margin-top: 14px; line-height: 1.8; color: #e2e8f0; font-size: 13px; }
.ai-result h2 { font-size: 14px; color: #a5b4fc; margin: 14px 0 6px; padding-bottom: 4px; border-bottom: 1px solid #4338ca; }
.ai-result p { margin: 6px 0; }
.ai-error { color: #fca5a5; padding: 10px 14px; background: #422006; border-radius: 6px; margin-top: 10px; font-size: 12px; }
.ai-meta { font-size: 10.5px; color: #818cf8; margin-top: 8px; }

footer.foot { margin-top: 24px; padding: 14px; background: #1e293b; border-radius: 8px; font-size: 12px; color: #94a3b8; line-height: 1.7; }

@media (max-width: 900px) {
  body { padding: 12px 12px 60px; }
  .price-grid, .fin-grid { grid-template-columns: repeat(2, 1fr); }
  h1 { font-size: 20px; }
  .price-big { font-size: 28px; }
  .chart-pane.price  { height: 320px; }
  .chart-pane.volume { height: 80px; }
  .chart-pane.value  { height: 80px; }
  .chart-info-bar { font-size: 11px; gap: 6px 10px; }
  .ma-legend label { padding: 2px 6px; font-size: 10.5px; }
  .period-tabs button { padding: 4px 10px; }
}
</style>
</head>
<body>

<nav>
  <a href="/qva-vvi-redefined-board" class="back">← 새 VVI 보드</a>
  <a href="/qva-watchlist">📋 H그룹/VPR</a>
  <a href="/rebreak">🔥 D+5 재돌파</a>
  <a href="/one-day-surge-board">⚡ 1DS</a>
  <a href="/qva-vvi-redefined-board">🎯 QVA 고점 재돌파</a>
</nav>

<h1><%= meta.name %><span class="code"><%= code %> · <%= meta.market || '-' %></span></h1>
<div class="subtitle">
  시가총액 <%= fmtMarketCap(meta.marketCap) %>
  <% if (meta.isEtf) { %> · ETF<% } %>
  <% if (meta.isSpecial) { %> · 우선주/리츠/스팩<% } %>
</div>

<!-- 시세 헤더 (KIS 실시간) -->
<div class="price-block">
  <div class="price-row">
    <span class="price-big"><%= fmtNum(dispPrice) %><span class="price-unit">원</span></span>
    <% if (dispChg != null) { %>
    <span class="price-change <%= dispChg > 0 ? 'pos' : (dispChg < 0 ? 'neg' : '') %>">
      <%= dispChg > 0 ? '▲' : (dispChg < 0 ? '▼' : '─') %>
      <% if (kisLive && kisLive.changeAbs != null) { %><%= Math.abs(kisLive.changeAbs).toLocaleString() %>원 <% } %>
      <%= fmtPct(dispChg) %>
    </span>
    <% } %>
  </div>
  <div class="price-meta">
    <% if (kisLive) { %>
    <span class="badge live">🟢 KIS 실시간</span>
    <% if (kisLive.prevClose) { %> · 전일 종가 <%= fmtNum(kisLive.prevClose) %>원<% } %>
    <% } else if (lastRow) { %>
    <span class="badge">📅 <%= fmtDate(lastRow.date) %> 종가 (KIS 실시간 호출 실패)</span>
    <% } else { %>
    <span class="badge">데이터 없음</span>
    <% } %>
  </div>
  <% if (kisLive) { %>
  <div class="price-grid" style="margin-top: 12px;">
    <div class="price-cell"><div class="label">시가</div><div class="value"><%= fmtNum(kisLive.open) %></div></div>
    <div class="price-cell"><div class="label">고가</div><div class="value"><%= fmtNum(kisLive.high) %></div></div>
    <div class="price-cell"><div class="label">저가</div><div class="value"><%= fmtNum(kisLive.low) %></div></div>
    <div class="price-cell"><div class="label">거래량</div><div class="value"><%= fmtNum(kisLive.volume) %></div></div>
  </div>
  <% } %>
</div>

<!-- ★ 메인 차트 (Lightweight Charts · 3-pane 동기화) -->
<% if (rows.length > 0) { %>
<div class="chart-card">
  <div class="chart-info-bar" id="chart-info-bar"></div>
  <div class="ma-legend" id="ma-legend"></div>
  <div class="period-tabs" id="period-tabs">
    <button data-period="3M">3개월</button>
    <button data-period="6M">6개월</button>
    <button data-period="1Y" class="active">1년</button>
    <button data-period="2Y">2년</button>
    <button data-period="5Y">5년</button>
    <button data-period="ALL">전체</button>
  </div>
  <div class="pane-label">📊 일봉 + 이동평균선</div>
  <div class="chart-pane price"  id="chart-price"></div>
  <div class="pane-label">📦 거래량 (20일 평균선)</div>
  <div class="chart-pane volume" id="chart-volume"></div>
  <div class="pane-label">💰 거래대금 (20일 평균선)</div>
  <div class="chart-pane value"  id="chart-value"></div>
</div>
<% } else { %>
<div class="empty-msg">차트 데이터가 없습니다 (cache/stock-charts-long/<%= code %>.json 부재).</div>
<% } %>

<!-- 새 VVI 보드 funnel 멤버십 -->
<% if (vviMembership) { %>
<div class="member-section">
  <h3>🎯 새 VVI 보드 위치</h3>
  <div class="member-row">
    <span class="stage <%= vviMembership.group %>"><%= vviMembership.label %></span>
    <% var it = vviMembership.item; %>
    <% if (it.qvaSignalDate) { %>QVA 발생일 <%= fmtDate(it.qvaSignalDate) %><% } %>
    <% if (it.vviDate) { %> · VVI 발생일 <%= fmtDate(it.vviDate) %><% } %>
    <% if (it.daysFromQvaToVvi != null) { %> · QVA→VVI <%= it.daysFromQvaToVvi %>거래일<% } %>
    <% if (it.vviValueRatio) { %> · 거래대금 ×<%= Number(it.vviValueRatio).toFixed(2) %><% } %>
    <% if (it.currentFromQvaCloseRate != null) { %> · QVA→현재 <%= fmtPct(it.currentFromQvaCloseRate, 1) %><% } %>
  </div>
</div>
<% } %>

<!-- 재무정보 -->
<h2>💰 재무정보 (DART)</h2>
<% if (financials && financials.latest) { %>
<%
  var lat = financials.latest, prior = financials.prior, growth = financials.growth || {};
  var reportLabel = lat.reportCode === '11011' ? '사업보고서' : (lat.reportCode === '11013' ? '1분기' : (lat.reportCode === '11012' ? '반기' : (lat.reportCode === '11014' ? '3분기' : lat.reportCode)));
%>
<div class="fin-grid">
  <div class="fin-cell">
    <div class="label">매출액</div>
    <div class="value"><%= fmtMoney(lat.revenue) %>원</div>
    <% if (growth.revenue != null) { %><div class="growth <%= growth.revenue > 0 ? 'pos' : 'neg' %>"><%= fmtPct(growth.revenue, 1) %> YoY</div><% } %>
    <% if (prior && prior.revenue) { %><div class="sub">전년 <%= fmtMoney(prior.revenue) %>원</div><% } %>
  </div>
  <div class="fin-cell">
    <div class="label">영업이익</div>
    <div class="value"><%= fmtMoney(lat.opIncome) %>원</div>
    <% if (growth.opIncome != null) { %><div class="growth <%= growth.opIncome > 0 ? 'pos' : 'neg' %>"><%= fmtPct(growth.opIncome, 1) %> YoY</div><% } %>
    <% if (prior && prior.opIncome) { %><div class="sub">전년 <%= fmtMoney(prior.opIncome) %>원</div><% } %>
  </div>
  <div class="fin-cell">
    <div class="label">당기순이익</div>
    <div class="value"><%= fmtMoney(lat.netIncome) %>원</div>
    <% if (growth.netIncome != null) { %><div class="growth <%= growth.netIncome > 0 ? 'pos' : 'neg' %>"><%= fmtPct(growth.netIncome, 1) %> YoY</div><% } %>
    <% if (prior && prior.netIncome) { %><div class="sub">전년 <%= fmtMoney(prior.netIncome) %>원</div><% } %>
  </div>
  <div class="fin-cell">
    <div class="label">기준 보고서</div>
    <div class="value"><%= lat.bsnsYear %></div>
    <div class="sub"><%= reportLabel %></div>
  </div>
</div>
<% } else { %>
<div class="empty-msg">DART 재무 캐시가 없습니다 (cache/dart-financials/<%= code %>.json 부재).</div>
<% } %>

<!-- AI 기업 분석 (재무 다음, 뉴스/공시 위) -->
<div class="ai-section">
  <h2>🤖 AI 기업 분석</h2>
  <p style="color: #c7d2fe; font-size: 12.5px; margin: 0 0 12px; line-height: 1.6;">
    버튼을 누르면 Gemini가 <strong>기업 분석 · 사업 내용 · 최근 이슈(호재/악재/리스크)</strong>를 정리해 줍니다.
    아래 재무·뉴스·공시를 근거로 분석합니다. 응답까지 5~15초 정도 걸립니다.
  </p>
  <button id="ai-btn" class="ai-btn">📊 AI 분석 시작</button>
  <div id="ai-output"></div>
</div>

<!-- 최근 뉴스 -->
<div class="list-card">
  <h2>📰 최근 뉴스 (Naver, 최대 8건)</h2>
  <% if (news && news.length > 0) { %>
    <% news.forEach(function(n) { %>
    <div class="list-item">
      <div class="meta">
        <% if (n.source) { %><span class="source"><%= n.source %></span><% } %>
        <% if (n.dateTimeFmt) { %><%= n.dateTimeFmt %><% } %>
      </div>
      <div class="title">
        <% if (n.url) { %><a href="<%= n.url %>" target="_blank" rel="noopener"><%= n.title %> ↗</a><% } else { %><%= n.title %><% } %>
      </div>
      <% if (n.body) { %><div class="body"><%= n.body %></div><% } %>
    </div>
    <% }) %>
  <% } else { %>
    <div class="empty-msg">
      뉴스를 불러오지 못했습니다.<% if (newsError) { %> <span style="color:#fca5a5;">(<%= newsError %>)</span><% } %>
    </div>
  <% } %>
</div>

<!-- 최근 공시 -->
<div class="list-card">
  <h2>📋 최근 공시 (DART, 최근 90일 / 최대 10건)</h2>
  <% if (disclosures && disclosures.length > 0) { %>
    <% disclosures.forEach(function(d) { %>
    <div class="list-item">
      <div class="meta">
        <% if (d.receiptDateFmt) { %><span class="source"><%= d.receiptDateFmt %></span><% } %>
        <% if (d.filerName) { %>· <%= d.filerName %><% } %>
      </div>
      <div class="title">
        <a href="<%= d.url %>" target="_blank" rel="noopener"><%= d.reportName %> ↗</a>
      </div>
    </div>
    <% }) %>
  <% } else { %>
    <div class="empty-msg">
      공시를 불러오지 못했습니다.<% if (disclosureError) { %> <span style="color:#fca5a5;">(<%= disclosureError %>)</span><% } %>
    </div>
  <% } %>
</div>

<footer class="foot">
  <strong>새 VVI 보드 종목 상세.</strong> 차트는 일일 갱신 캐시 기반(전체 기간 일봉),
  실시간 가격은 KIS Open Trading API.<br>
  AI 분석은 호출 시점의 재무·공시·뉴스 + Gemini 학습 지식 기반 — <strong>매수 추천이 아닙니다.</strong>
</footer>

<% if (rows.length > 0) { %>
<script>
// ─── Lightweight Charts 메인 차트 (캔들 + 6 MA + 거래량 + 거래대금, 3-pane 동기화) ───
const ROWS = <%- JSON.stringify(rows) %>;
const STOCK_NAME = <%- JSON.stringify(meta.name) %>;
const STOCK_MARKET = <%- JSON.stringify(meta.market || '') %>;
const STOCK_CODE_VIEW = <%- JSON.stringify(code) %>;

(function buildChart() {
  if (!window.LightweightCharts || ROWS.length === 0) return;

  // ── 포맷 헬퍼 ──
  const toLwTime = (d) => { const s = String(d); return s.slice(0,4)+'-'+s.slice(4,6)+'-'+s.slice(6,8); };
  const fmtN = v => v != null ? Math.round(Number(v)).toLocaleString() : '-';
  const fmtMoney = v => {
    if (!v) return '-';
    const n = Number(v);
    if (n >= 1e12) return (n/1e12).toFixed(2)+'조';
    if (n >= 1e8)  return (n/1e8).toFixed(1)+'억';
    if (n >= 1e4)  return (n/1e4).toFixed(0)+'만';
    return Math.round(n).toLocaleString();
  };
  const fmtVol = v => {
    if (!v) return '-';
    if (v >= 1e8) return (v/1e8).toFixed(2)+'억';
    if (v >= 1e4) return (v/1e4).toFixed(0)+'만';
    return Math.round(v).toLocaleString();
  };
  const fmtPctL = v => v == null ? '-' : (v>0?'+':'') + Number(v).toFixed(2) + '%';

  // ── MA 계산 (close 기준) ──
  const MA = [
    { p: 5,   label: 'MA5',   color: '#ec4899' },
    { p: 10,  label: 'MA10',  color: '#f59e0b' },
    { p: 20,  label: 'MA20',  color: '#22c55e' },
    { p: 60,  label: 'MA60',  color: '#3b82f6' },
    { p: 120, label: 'MA120', color: '#8b5cf6' },
    { p: 240, label: 'MA240', color: '#737373' },
  ];
  function calcMa(period) {
    const out = [];
    let sum = 0;
    for (let i = 0; i < ROWS.length; i++) {
      sum += ROWS[i].close;
      if (i >= period) sum -= ROWS[i-period].close;
      if (i >= period - 1) out.push({ time: toLwTime(ROWS[i].date), value: sum / period });
    }
    return out;
  }
  function rollingAvg(period, key, scale) {
    scale = scale || 1;
    const out = [];
    let sum = 0;
    for (let i = 0; i < ROWS.length; i++) {
      const v = (Number(ROWS[i][key]) || 0) * scale;
      sum += v;
      if (i >= period) {
        const pv = (Number(ROWS[i-period][key]) || 0) * scale;
        sum -= pv;
      }
      if (i >= period - 1) out.push({ time: toLwTime(ROWS[i].date), value: sum / period });
    }
    return out;
  }

  // ── 시리즈 데이터 ──
  const candles = ROWS.map(r => ({ time: toLwTime(r.date), open: r.open, high: r.high, low: r.low, close: r.close }));
  const volBars = ROWS.map(r => ({
    time: toLwTime(r.date), value: r.volume,
    color: r.close >= r.open ? 'rgba(239,68,68,0.7)' : 'rgba(59,130,246,0.7)',
  }));
  const valBars = ROWS.map(r => ({
    time: toLwTime(r.date), value: r.valueApprox || (r.close * r.volume),
    color: r.close >= r.open ? 'rgba(239,68,68,0.7)' : 'rgba(59,130,246,0.7)',
  }));
  const avgVol20 = rollingAvg(20, 'volume');
  const avgVal20 = ROWS.map((r, i) => {
    let sum = 0, cnt = 0;
    for (let j = Math.max(0, i-19); j <= i; j++) { sum += (ROWS[j].valueApprox || (ROWS[j].close*ROWS[j].volume)); cnt++; }
    return i >= 19 ? { time: toLwTime(r.date), value: sum / cnt } : null;
  }).filter(x => x);

  // ── 차트 옵션 (KIS 흰 배경 톤) ──
  const baseOpts = {
    layout: { background: { type: 'solid', color: '#ffffff' }, textColor: '#1f2937',
      fontFamily: '-apple-system, "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif' },
    grid: { vertLines: { color: '#f3f4f6' }, horzLines: { color: '#f3f4f6' } },
    rightPriceScale: { borderColor: '#e5e7eb' },
    timeScale: { borderColor: '#e5e7eb' },
    crosshair: { mode: 0 /* Normal */, vertLine: { width: 1, color: '#9ca3af', style: 0 }, horzLine: { width: 1, color: '#9ca3af', style: 0 } },
  };
  const priceContainer = document.getElementById('chart-price');
  const volContainer   = document.getElementById('chart-volume');
  const valContainer   = document.getElementById('chart-value');

  const priceChart = LightweightCharts.createChart(priceContainer, {
    ...baseOpts, width: priceContainer.clientWidth, height: priceContainer.clientHeight,
    rightPriceScale: { ...baseOpts.rightPriceScale, scaleMargins: { top: 0.08, bottom: 0.08 } },
    timeScale: { ...baseOpts.timeScale, visible: false },
  });
  const volChart = LightweightCharts.createChart(volContainer, {
    ...baseOpts, width: volContainer.clientWidth, height: volContainer.clientHeight,
    rightPriceScale: { ...baseOpts.rightPriceScale, scaleMargins: { top: 0.1, bottom: 0.05 } },
    timeScale: { ...baseOpts.timeScale, visible: false },
  });
  const valChart = LightweightCharts.createChart(valContainer, {
    ...baseOpts, width: valContainer.clientWidth, height: valContainer.clientHeight,
    rightPriceScale: { ...baseOpts.rightPriceScale, scaleMargins: { top: 0.1, bottom: 0.05 } },
    timeScale: { ...baseOpts.timeScale, visible: true },
  });

  // ── 시리즈 ──
  // 캔들 (한국 관습: 상승=빨강, 하락=파랑)
  const candleSeries = priceChart.addCandlestickSeries({
    upColor: '#ef4444', downColor: '#3b82f6',
    borderUpColor: '#ef4444', borderDownColor: '#3b82f6',
    wickUpColor: '#ef4444', wickDownColor: '#3b82f6',
    priceFormat: { type: 'price', precision: 0, minMove: 1 },
  });
  candleSeries.setData(candles);

  // MA × 6
  const maSeriesMap = {};
  for (const m of MA) {
    const s = priceChart.addLineSeries({
      color: m.color, lineWidth: 1.2,
      priceLineVisible: false, lastValueVisible: false, crosshairMarkerVisible: false,
    });
    s.setData(calcMa(m.p));
    maSeriesMap[m.p] = s;
  }

  // 거래량
  const volSeries = volChart.addHistogramSeries({ priceFormat: { type: 'volume' }, priceLineVisible: false });
  volSeries.setData(volBars);
  const volAvgSeries = volChart.addLineSeries({
    color: '#737373', lineWidth: 1, priceLineVisible: false, lastValueVisible: false, crosshairMarkerVisible: false,
  });
  volAvgSeries.setData(avgVol20);

  // 거래대금
  const valSeries = valChart.addHistogramSeries({ priceFormat: { type: 'volume' }, priceLineVisible: false });
  valSeries.setData(valBars);
  const valAvgSeries = valChart.addLineSeries({
    color: '#737373', lineWidth: 1, priceLineVisible: false, lastValueVisible: false, crosshairMarkerVisible: false,
  });
  valAvgSeries.setData(avgVal20);

  // ── 시간축 동기화 ──
  const charts = [priceChart, volChart, valChart];
  const primarySeries = new Map([[priceChart, candleSeries], [volChart, volSeries], [valChart, valSeries]]);
  let suppressSync = false;
  charts.forEach(c => {
    c.timeScale().subscribeVisibleLogicalRangeChange(range => {
      if (suppressSync || range == null) return;
      suppressSync = true;
      charts.forEach(other => { if (other !== c) other.timeScale().setVisibleLogicalRange(range); });
      suppressSync = false;
    });
  });

  // ── 정보바 / MA 범례 hover 갱신 ──
  const infoBar = document.getElementById('chart-info-bar');
  const maLegend = document.getElementById('ma-legend');
  const maToggleState = { 5: true, 10: true, 20: true, 60: true, 120: true, 240: true };

  function infoBarHtml(idx) {
    if (idx < 0 || idx >= ROWS.length) return '';
    const r = ROWS[idx];
    const prev = idx > 0 ? ROWS[idx-1] : null;
    const chg = prev ? ((r.close / prev.close - 1) * 100) : null;
    const chgCls = chg == null ? '' : (chg > 0 ? 'pos' : 'neg');
    const dt = String(r.date).slice(0,4)+'-'+String(r.date).slice(4,6)+'-'+String(r.date).slice(6,8);
    return [
      '<span class="ci-name">' + STOCK_NAME + '</span>',
      '<span class="ci-code">' + STOCK_CODE_VIEW + '</span>',
      '<span class="ci-mkt">' + STOCK_MARKET + '</span>',
      '<span class="ci-date">' + dt + '</span>',
      '<span class="ci-ohlc">시 <strong>' + fmtN(r.open) + '</strong> 고 <strong>' + fmtN(r.high) + '</strong> 저 <strong>' + fmtN(r.low) + '</strong> 종 <strong>' + fmtN(r.close) + '</strong></span>',
      chg != null ? '<span class="ci-chg ' + chgCls + '">' + fmtPctL(chg) + '</span>' : '',
      '<span class="ci-volval">거래량 <strong>' + fmtVol(r.volume) + '</strong> · 거래대금 <strong>' + fmtMoney(r.valueApprox || (r.close*r.volume)) + '</strong></span>',
    ].filter(Boolean).join(' ');
  }
  function maAtIdx(period, idx) {
    const startIdx = period - 1;
    if (idx < startIdx) return null;
    let sum = 0;
    for (let j = idx - period + 1; j <= idx; j++) sum += ROWS[j].close;
    return sum / period;
  }
  function maLegendHtml(idx) {
    return MA.map(m => {
      const v = maAtIdx(m.p, idx);
      const off = maToggleState[m.p] === false ? ' off' : '';
      return '<label class="ma-tog' + off + '" data-ma="' + m.p + '">' +
             '<span class="dot" style="background:' + m.color + ';"></span>' +
             '<span class="ma-label" style="color:' + m.color + '">' + m.label + '</span>' +
             '<span class="ma-value">' + (v != null ? fmtN(v) : '-') + '</span>' +
             '</label>';
    }).join('');
  }

  const lastIdx = ROWS.length - 1;
  let currentIdx = lastIdx;
  infoBar.innerHTML = infoBarHtml(currentIdx);
  maLegend.innerHTML = maLegendHtml(currentIdx);

  function findIdxByTime(time) {
    if (!time) return -1;
    let dateNum;
    if (typeof time === 'string') dateNum = time.replace(/-/g, '');
    else if (typeof time === 'object' && time.year)
      dateNum = String(time.year) + String(time.month).padStart(2,'0') + String(time.day).padStart(2,'0');
    else return -1;
    return ROWS.findIndex(r => r.date === dateNum);
  }
  function onCrosshair(param) {
    if (!param || !param.time) {
      currentIdx = lastIdx;
      infoBar.innerHTML = infoBarHtml(currentIdx);
      maLegend.innerHTML = maLegendHtml(currentIdx);
      charts.forEach(other => { try { other.clearCrosshairPosition(); } catch (_) {} });
      return;
    }
    const idx = findIdxByTime(param.time);
    if (idx < 0) return;
    currentIdx = idx;
    infoBar.innerHTML = infoBarHtml(currentIdx);
    maLegend.innerHTML = maLegendHtml(currentIdx);
    // crosshair 다른 차트에도 표시
    const time = param.time;
    charts.forEach(other => {
      const s = primarySeries.get(other);
      if (s && other !== this) {
        try { other.setCrosshairPosition(NaN, time, s); } catch (_) {}
      }
    });
  }
  charts.forEach(c => c.subscribeCrosshairMove(onCrosshair));

  // ── MA 토글 (체크박스 역할) ──
  maLegend.addEventListener('click', (e) => {
    const lab = e.target.closest('label[data-ma]');
    if (!lab) return;
    const p = Number(lab.dataset.ma);
    maToggleState[p] = !(maToggleState[p] !== false);
    maSeriesMap[p].applyOptions({ visible: maToggleState[p] });
    maLegend.innerHTML = maLegendHtml(currentIdx);
  });

  // ── 기간 선택 ──
  const PERIOD_DAYS = { '3M': 65, '6M': 130, '1Y': 250, '2Y': 500, '5Y': 1250, 'ALL': ROWS.length };
  function setPeriod(p) {
    const n = PERIOD_DAYS[p] || ROWS.length;
    const from = Math.max(0, ROWS.length - n);
    const to = ROWS.length - 1;
    suppressSync = true;
    charts.forEach(c => c.timeScale().setVisibleLogicalRange({ from, to }));
    suppressSync = false;
    document.querySelectorAll('#period-tabs button').forEach(b => b.classList.toggle('active', b.dataset.period === p));
  }
  document.getElementById('period-tabs').addEventListener('click', (e) => {
    if (e.target.tagName === 'BUTTON' && e.target.dataset.period) setPeriod(e.target.dataset.period);
  });
  setPeriod('1Y');

  // ── Resize ──
  function resizeAll() {
    [[priceChart, priceContainer], [volChart, volContainer], [valChart, valContainer]].forEach(([c, el]) => {
      c.applyOptions({ width: el.clientWidth, height: el.clientHeight });
    });
  }
  window.addEventListener('resize', resizeAll);
})();
</script>
<% } %>

<script>
// ─── AI 분석 버튼 ───
const aiBtn = document.getElementById('ai-btn');
const aiOutput = document.getElementById('ai-output');
const STOCK_CODE = '<%= code %>';

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}

function md2html(text) {
  const lines = String(text || '').split('\n');
  let html = '', inP = false;
  for (const line of lines) {
    const t = line.trim();
    if (/^##\s+/.test(t)) {
      if (inP) { html += '</p>'; inP = false; }
      html += '<h2>' + escapeHtml(t.replace(/^##\s+/, '')) + '</h2>';
    } else if (t === '') {
      if (inP) { html += '</p>'; inP = false; }
    } else {
      if (!inP) { html += '<p>'; inP = true; } else { html += '<br>'; }
      html += escapeHtml(t);
    }
  }
  if (inP) html += '</p>';
  return html;
}

aiBtn.addEventListener('click', async () => {
  aiBtn.disabled = true;
  aiOutput.innerHTML = '<div class="ai-result"><span class="ai-spinner"></span>AI 분석 중... (재무·공시·뉴스 정리 후 응답까지 5~15초)</div>';
  try {
    const r = await fetch('/qva-vvi-redefined/' + STOCK_CODE + '/ai', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({}),
    });
    if (!r.ok) {
      const err = await r.json().catch(() => ({ error: 'HTTP ' + r.status }));
      throw new Error(err.error || ('HTTP ' + r.status));
    }
    const data = await r.json();
    aiOutput.innerHTML =
      '<div class="ai-result">' + md2html(data.text || '') + '</div>' +
      '<div class="ai-meta">' + (data.cached ? '⚡ 캐시 응답 · ' : '') + '모델: ' + escapeHtml(data.model || '-') + '</div>';
    aiBtn.disabled = false;
    aiBtn.textContent = '🔄 다시 분석';
  } catch (e) {
    aiOutput.innerHTML = '<div class="ai-error">AI 분석 실패: ' + escapeHtml(e.message) + '</div>';
    aiBtn.disabled = false;
  }
});
</script>

</body>
</html>
