<%
function fmtNum(v) { return v != null ? Math.round(Number(v)).toLocaleString() : '-'; }
function fmtDate(d) { if (!d || String(d).length !== 8) return d || '-'; return String(d).slice(0,4)+'-'+String(d).slice(4,6)+'-'+String(d).slice(6,8); }
function fmtPct(v, prec) {
  if (v == null) return '-';
  prec = prec == null ? 2 : prec;
  return (v > 0 ? '+' : '') + Number(v).toFixed(prec) + '%';
}
function fmtMarketCap(won) {
  if (!won || won <= 0) return '-';
  const eok = won / 1e8;
  if (eok >= 10000) return (eok / 10000).toFixed(2) + '조';
  return Math.round(eok).toLocaleString() + '억';
}
function fmtMoney(won) {
  if (!won || won === 0) return '-';
  const v = Number(won);
  if (v >= 1e12) return (v/1e12).toFixed(2) + '조';
  if (v >= 1e8)  return (v/1e8).toFixed(1) + '억';
  if (v >= 1e4)  return (v/1e4).toFixed(0) + '만';
  return Math.round(v).toLocaleString();
}
const rows = chartRows || [];
const lastRow = rows.length > 0 ? rows[rows.length - 1] : null;
const dispPrice = (priceQuote && priceQuote.price) || (lastRow && lastRow.close);
const dispChg = (priceQuote && priceQuote.changeRate != null) ? priceQuote.changeRate : null;
%>
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title><%= meta.name %> · 새 VVI 종목 상세</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- TradingView Lightweight Charts (v4) — 캔들·MA·히스토그램·crosshair 지원 -->
<script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
<style>
* { box-sizing: border-box; }
body { margin: 0 auto; padding: 18px 24px 80px; max-width: 1200px;
  font-family: -apple-system, "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
  background: #0f172a; color: #e2e8f0; font-size: 13px;
}
nav { display:flex; gap:10px; flex-wrap:wrap; padding:8px 0 14px; border-bottom:1px solid #1e293b; margin-bottom:14px; font-size: 12px; }
nav a { color:#94a3b8; text-decoration:none; padding:4px 8px; border-radius:4px; }
nav a:hover { color:#e2e8f0; background:#1e293b; }
nav a.back { color: #5eead4; }
h1 { font-size: 24px; margin: 0 0 4px; color: #f1f5f9; font-weight: 700; }
h1 .code { color: #64748b; font-size: 16px; font-weight: 400; margin-left: 8px; }
h2 { font-size: 16px; margin: 22px 0 10px; color: #cbd5e1; }
.subtitle { font-size: 13px; color: #94a3b8; margin-bottom: 14px; }

.price-block { background: #1e293b; border-radius: 10px; padding: 16px 20px; margin-bottom: 14px; border-left: 4px solid #14b8a6; }
.price-row { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.price-big { font-size: 32px; font-weight: 700; color: #f1f5f9; font-variant-numeric: tabular-nums; }
.price-unit { font-size: 14px; font-weight: 400; color: #94a3b8; margin-left: 2px; }
.price-change { font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums; }
.price-change.pos { color: #fca5a5; }   /* 한국 관습: 상승 = 빨강 */
.price-change.neg { color: #93c5fd; }   /* 하락 = 파랑 */
.price-meta { color: #94a3b8; font-size: 12px; margin-top: 6px; }
.price-meta .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; background: #0f172a; border: 1px solid #334155; margin-right: 4px; font-size: 11px; }
.price-meta .badge.live { background: #064e3b; color: #6ee7b7; border-color: #10b981; font-weight: 600; }
.price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 14px; }
.price-cell { background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 10px 12px; }
.price-cell .label { font-size: 11px; color: #94a3b8; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.3px; }
.price-cell .value { font-size: 16px; font-weight: 600; color: #e2e8f0; font-variant-numeric: tabular-nums; }

/* ── 메인 차트 카드 (KIS MTS 느낌의 흰 카드) ── */
.chart-card {
  background: #ffffff; color: #1f2937;
  border-radius: 12px; padding: 14px 16px;
  margin-bottom: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.35);
}
.chart-info-bar {
  display: flex; flex-wrap: wrap; gap: 10px 14px;
  align-items: baseline;
  padding-bottom: 10px; margin-bottom: 8px;
  border-bottom: 1px solid #e5e7eb;
  font-size: 12px; color: #4b5563;
  font-variant-numeric: tabular-nums;
}
.chart-info-bar .ci-name { font-size: 14px; font-weight: 700; color: #111827; }
.chart-info-bar .ci-code { color: #9ca3af; font-size: 11px; margin-left: 4px; }
.chart-info-bar .ci-mkt { font-size: 10px; padding: 1px 6px; border: 1px solid #d1d5db; border-radius: 3px; color: #6b7280; }
.chart-info-bar .ci-date { color: #6b7280; }
.chart-info-bar .ci-ohlc strong, .chart-info-bar .ci-volval strong { color: #1f2937; font-weight: 600; }
.chart-info-bar .ci-chg.pos { color: #ef4444; font-weight: 600; }   /* 상승 빨강 */
.chart-info-bar .ci-chg.neg { color: #3b82f6; font-weight: 600; }   /* 하락 파랑 */

.ma-legend { display: flex; gap: 6px; flex-wrap: wrap; padding-bottom: 10px; font-size: 11px; }
.ma-legend label { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; user-select: none;
  padding: 3px 9px; border-radius: 4px; background: #f9fafb; border: 1px solid #e5e7eb;
  font-variant-numeric: tabular-nums; }
.ma-legend label.off { opacity: 0.4; }
.ma-legend .dot { width: 10px; height: 2px; display: inline-block; }
.ma-legend .ma-label { font-weight: 600; }
.ma-legend .ma-value { color: #6b7280; }

.period-tabs { display: flex; gap: 4px; flex-wrap: wrap; padding-bottom: 10px; }
.period-tabs button {
  background: #f3f4f6; border: 1px solid #e5e7eb; color: #4b5563;
  padding: 5px 14px; border-radius: 4px; font-size: 11.5px; cursor: pointer; font-weight: 500;
}
.period-tabs button:hover { background: #e5e7eb; }
.period-tabs button.active { background: #1f2937; color: #fff; border-color: #1f2937; }

.chart-mode-note {
  font-size: 10.5px; color: #6b7280; padding: 0 0 8px;
  font-style: italic; line-height: 1.5;
}
.chart-mode-note:empty { display: none; }

.pane-label { font-size: 10px; color: #9ca3af; padding: 2px 0; font-weight: 600; letter-spacing: 0.3px; }
.chart-pane { position: relative; background: #ffffff; }
.chart-pane.price  { height: 380px; }
.chart-pane.volume { height: 100px; }
.chart-pane.value  { height: 100px; }

/* ── funnel / 재무 / AI / 뉴스 / 공시 ── */
.member-section { background: #1e293b; border-radius: 10px; padding: 14px 18px; margin-bottom: 12px; border-left: 4px solid #14b8a6; }
.member-section h3 { font-size: 13px; margin: 0 0 8px; color: #cbd5e1; font-weight: 600; }
.member-row { font-size: 12px; color: #94a3b8; line-height: 1.7; }
.member-row .stage { display: inline-block; padding: 2px 8px; border-radius: 4px; background: #042f2e; color: #5eead4; margin-right: 4px; font-size: 11px; font-weight: 600; }
.member-row .stage.strong { background: #7f1d1d; color: #fca5a5; }
.member-row .stage.valueInsuf { background: #422006; color: #fde68a; }
.member-row .stage.waiting { background: #1e293b; color: #cbd5e1; border: 1px solid #475569; }

/* ── 📋 기업정보 mega-section (CompanyGuide 스타일) ── */
.info-section { background: #1e293b; border-radius: 10px; padding: 16px 20px; margin: 16px 0; }
.info-section > h2 {
  margin: 0 0 14px; font-size: 17px; color: #e2e8f0; font-weight: 700;
  border-bottom: 2px solid #334155; padding-bottom: 8px;
}
.info-section > h3 {
  margin: 18px 0 8px; font-size: 14px; color: #cbd5e1; font-weight: 600;
  display: flex; align-items: center; gap: 6px;
}
.info-section > h3 .info-source {
  font-size: 10.5px; color: #64748b; font-weight: 400;
  padding: 1px 6px; border: 1px solid #334155; border-radius: 3px;
}
.info-table {
  display: grid;
  grid-template-columns: 110px 1fr 110px 1fr;
  gap: 1px;
  background: #334155;
  border: 1px solid #334155;
  border-radius: 5px;
  overflow: hidden;
  font-size: 12px;
}
.info-table .info-label, .info-table .info-value { padding: 7px 10px; }
.info-table .info-label { background: #0f172a; color: #94a3b8; font-weight: 600; }
.info-table .info-value { background: #1e293b; color: #e2e8f0; font-variant-numeric: tabular-nums; word-break: break-all; }
.info-table .info-value.pos  { color: #fca5a5; font-weight: 600; }
.info-table .info-value.neg  { color: #93c5fd; font-weight: 600; }
.info-table .info-value.warn { color: #fbbf24; }
.info-table .info-value.muted { color: #64748b; font-style: italic; }
.info-table .info-value a { color: #38bdf8; text-decoration: none; }
.info-table .info-value a:hover { text-decoration: underline; }
.info-table .info-value.span-3   { grid-column: span 3; }
.info-table .info-value.span-full { grid-column: 2 / -1; }
.info-table .info-value .yoy-pos { color: #fca5a5; font-weight: 600; margin-left: 4px; }
.info-table .info-value .yoy-neg { color: #93c5fd; font-weight: 600; margin-left: 4px; }
.info-table .info-value .date-meta { color: #64748b; font-size: 10.5px; margin-left: 4px; }

.risk-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
.risk-chips .chip {
  font-size: 10.5px; padding: 2px 8px; border-radius: 4px;
  background: #422006; color: #fbbf24; border: 1px solid #f59e0b;
}
.risk-chips .chip.danger { background: #7f1d1d; color: #fca5a5; border-color: #ef4444; }

.biz-summary-block { background: #0f172a; border-radius: 6px; padding: 12px 14px; margin-top: 8px; }
.biz-summary-block .biz-result { margin-top: 12px; line-height: 1.7; color: #e2e8f0; font-size: 13px; }
.biz-summary-block .biz-result h2 {
  font-size: 13px; color: #a5b4fc; margin: 12px 0 4px;
  padding-bottom: 3px; border-bottom: 1px solid #4338ca;
}
.biz-summary-block .biz-result p { margin: 6px 0; }

.list-card { background: #1e293b; border-radius: 10px; padding: 14px 18px; margin-bottom: 12px; }
.list-card h2 { margin: 0 0 10px; }
.list-item { padding: 8px 0; border-bottom: 1px solid #334155; font-size: 12px; line-height: 1.6; }
.list-item:last-child { border-bottom: none; }
.list-item .meta { color: #64748b; font-size: 11px; margin-bottom: 2px; }
.list-item .meta .source { color: #94a3b8; margin-right: 6px; }
.list-item .title { color: #e2e8f0; font-weight: 500; }
.list-item .title a { color: #38bdf8; text-decoration: none; }
.list-item .title a:hover { text-decoration: underline; }
.list-item .body { color: #94a3b8; font-size: 11.5px; margin-top: 3px; }

.empty-msg { padding: 12px; background: #1e293b; border-radius: 6px; color: #94a3b8; font-size: 12px; }

/* AI 분석 영역 */
.ai-section { background: linear-gradient(135deg, #1e1b4b 0%, #1e293b 100%); border-radius: 10px; padding: 18px 20px; margin-top: 16px; margin-bottom: 16px; border: 1px solid #4338ca; }
.ai-section h2 { color: #c7d2fe; margin: 0 0 10px; }
.ai-btn { background: #4f46e5; color: #fff; border: none; padding: 10px 22px; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.ai-btn:hover { background: #6366f1; }
.ai-btn:disabled { background: #4338ca; opacity: 0.6; cursor: not-allowed; }
.ai-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid #c7d2fe; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: middle; margin-right: 8px; }
@keyframes spin { to { transform: rotate(360deg); } }
.ai-result { margin-top: 14px; line-height: 1.8; color: #e2e8f0; font-size: 13px; }
.ai-result h2 { font-size: 14px; color: #a5b4fc; margin: 14px 0 6px; padding-bottom: 4px; border-bottom: 1px solid #4338ca; }
.ai-result p { margin: 6px 0; }
.ai-error { color: #fca5a5; padding: 10px 14px; background: #422006; border-radius: 6px; margin-top: 10px; font-size: 12px; }
.ai-meta { font-size: 10.5px; color: #818cf8; margin-top: 8px; }

footer.foot { margin-top: 24px; padding: 14px; background: #1e293b; border-radius: 8px; font-size: 12px; color: #94a3b8; line-height: 1.7; }

@media (max-width: 900px) {
  body { padding: 12px 12px 60px; }
  .price-grid { grid-template-columns: repeat(2, 1fr); }
  h1 { font-size: 20px; }
  .price-big { font-size: 28px; }
  .chart-pane.price  { height: 360px; }   /* 모바일에서도 200D 차트 흐름 보이게 충분히 */
  .chart-pane.volume { height: 90px; }
  .chart-pane.value  { height: 90px; }
  .info-table { grid-template-columns: 90px 1fr; }
  .info-table .info-value.span-3,
  .info-table .info-value.span-full { grid-column: 2; }
  .chart-info-bar { font-size: 11px; gap: 6px 10px; }
  .ma-legend label { padding: 2px 6px; font-size: 10.5px; }
  .period-tabs button { padding: 4px 10px; }
}
</style>
</head>
<body>

<nav>
  <a href="/qva-vvi-redefined-board" class="back">← 새 VVI 보드</a>
  <a href="/qva-watchlist">📋 H그룹/VPR</a>
  <a href="/rebreak">🔥 D+5 재돌파</a>
  <a href="/one-day-surge-board">⚡ 1DS</a>
  <a href="/qva-vvi-redefined-board">🎯 QVA 고점 재돌파</a>
</nav>

<h1><%= meta.name %><span class="code"><%= code %> · <%= meta.market || '-' %></span></h1>
<div class="subtitle">
  시가총액 <%= fmtMarketCap(meta.marketCap) %>
  <% if (meta.isEtf) { %> · ETF<% } %>
  <% if (meta.isSpecial) { %> · 우선주/리츠/스팩<% } %>
</div>

<!-- 시세 헤더 (KIS 실시간) -->
<div class="price-block">
  <div class="price-row">
    <span class="price-big"><%= fmtNum(dispPrice) %><span class="price-unit">원</span></span>
    <% if (dispChg != null) { %>
    <span class="price-change <%= dispChg > 0 ? 'pos' : (dispChg < 0 ? 'neg' : '') %>">
      <%= dispChg > 0 ? '▲' : (dispChg < 0 ? '▼' : '─') %>
      <% if (priceQuote && priceQuote.changeAbs != null) { %><%= Math.abs(priceQuote.changeAbs).toLocaleString() %>원 <% } %>
      <%= fmtPct(dispChg) %>
    </span>
    <% } %>
  </div>
  <div class="price-meta">
    <% if (priceQuote) { %>
    <span class="badge live">🟢 KIS 실시간</span>
    <% if (priceQuote.prevClose) { %> · 전일 종가 <%= fmtNum(priceQuote.prevClose) %>원<% } %>
    · <span style="color:#64748b;">자세한 시세는 아래 "📈 시세현황" 표 참조</span>
    <% } else if (lastRow) { %>
    <span class="badge">📅 <%= fmtDate(lastRow.date) %> 종가 (KIS 실시간 호출 실패)</span>
    <% } else { %>
    <span class="badge">데이터 없음</span>
    <% } %>
  </div>
</div>

<!-- ★ 메인 차트 (Lightweight Charts · 3-pane 동기화) -->
<% if (rows.length > 0) { %>
<div class="chart-card">
  <div class="chart-info-bar" id="chart-info-bar"></div>
  <div class="ma-legend" id="ma-legend"></div>
  <div class="period-tabs" id="period-tabs">
    <button data-period="1M">1개월</button>
    <button data-period="3M">3개월</button>
    <button data-period="6M">6개월</button>
    <button data-period="200D" class="active">200일</button>
    <button data-period="1Y">1년</button>
    <button data-period="ALL">전체</button>
  </div>
  <div class="chart-mode-note" id="chart-mode-note"></div>
  <div class="pane-label">📊 일봉 + 이동평균선</div>
  <div class="chart-pane price"  id="chart-price"></div>
  <div class="pane-label">📦 거래량 (20일 평균선)</div>
  <div class="chart-pane volume" id="chart-volume"></div>
  <div class="pane-label">💰 거래대금 (20일 평균선)</div>
  <div class="chart-pane value"  id="chart-value"></div>
</div>
<% } else { %>
<div class="empty-msg">차트 데이터가 없습니다 (cache/stock-charts-long/<%= code %>.json 부재).</div>
<% } %>

<!-- 새 VVI 보드 funnel 멤버십 -->
<% if (vviMembership) { %>
<div class="member-section">
  <h3>🎯 새 VVI 보드 위치</h3>
  <div class="member-row">
    <span class="stage <%= vviMembership.group %>"><%= vviMembership.label %></span>
    <% var it = vviMembership.item; %>
    <% if (it.qvaSignalDate) { %>QVA 발생일 <%= fmtDate(it.qvaSignalDate) %><% } %>
    <% if (it.vviDate) { %> · VVI 발생일 <%= fmtDate(it.vviDate) %><% } %>
    <% if (it.daysFromQvaToVvi != null) { %> · QVA→VVI <%= it.daysFromQvaToVvi %>거래일<% } %>
    <% if (it.vviValueRatio) { %> · 거래대금 ×<%= Number(it.vviValueRatio).toFixed(2) %><% } %>
    <% if (it.currentFromQvaCloseRate != null) { %> · QVA→현재 <%= fmtPct(it.currentFromQvaCloseRate, 1) %><% } %>
  </div>
</div>
<% } %>

<!-- ★ 기업정보 mega-section (CompanyGuide 스타일) -->
<section class="info-section">
  <h2>📋 기업정보</h2>

  <!-- 1. 기본정보 -->
  <h3>🏢 기본정보 <span class="info-source">DART · KIS</span></h3>
  <div class="info-table">
    <div class="info-label">종목명</div>
    <div class="info-value"><%= meta.name %></div>
    <div class="info-label">종목코드</div>
    <div class="info-value"><%= code %></div>

    <div class="info-label">시장</div>
    <div class="info-value"><%= meta.market || '-' %></div>
    <div class="info-label">대표이사</div>
    <div class="info-value <%= companyInfo && companyInfo.ceoName ? '' : 'muted' %>"><%= (companyInfo && companyInfo.ceoName) || '–' %></div>

    <div class="info-label">설립일</div>
    <div class="info-value <%= companyInfo && companyInfo.establishedDateFmt ? '' : 'muted' %>"><%= (companyInfo && companyInfo.establishedDateFmt) || '–' %></div>
    <div class="info-label">결산월</div>
    <% var accMonth = (companyInfo && companyInfo.accountingMonth) || (priceQuote && priceQuote.accountingMonth); %>
    <div class="info-value <%= accMonth ? '' : 'muted' %>"><%= accMonth ? accMonth + '월' : '–' %></div>

    <div class="info-label">자본금</div>
    <div class="info-value"><%= priceQuote && priceQuote.capital ? Number(priceQuote.capital).toLocaleString() + '억원' : '–' %></div>
    <div class="info-label">액면가</div>
    <div class="info-value"><%= priceQuote && priceQuote.faceValue ? fmtNum(priceQuote.faceValue) + '원' : '–' %></div>

    <div class="info-label">상장주식수</div>
    <div class="info-value"><%= priceQuote && priceQuote.listedShares ? Number(priceQuote.listedShares).toLocaleString() + '주' : '–' %></div>
    <div class="info-label">시가총액</div>
    <div class="info-value"><%= fmtMarketCap(meta.marketCap) %></div>

    <% if (kisStockInfo) { %>
    <div class="info-label">업종 (대분류)</div>
    <div class="info-value"><%= kisStockInfo.industryLclsName || '–' %></div>
    <div class="info-label">업종 (중분류)</div>
    <div class="info-value"><%= kisStockInfo.industryMclsName || '–' %></div>

    <div class="info-label">업종 (소분류)</div>
    <div class="info-value span-3"><%= kisStockInfo.industryScls || '–' %></div>

    <div class="info-label">표준산업분류</div>
    <div class="info-value span-3"><%= kisStockInfo.ksicName || '–' %></div>
    <% } %>

    <% if (kisStockInfo || (companyInfo && companyInfo.corpNameEng)) { %>
    <div class="info-label">영문명</div>
    <div class="info-value span-3"><%= (kisStockInfo && kisStockInfo.productNameEng) || (companyInfo && companyInfo.corpNameEng) || '–' %></div>
    <% } %>

    <% if (companyInfo) { %>
    <div class="info-label">주소</div>
    <div class="info-value span-3 <%= companyInfo.address ? '' : 'muted' %>"><%= companyInfo.address || '–' %></div>
    <div class="info-label">홈페이지</div>
